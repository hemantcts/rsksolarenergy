---
/** GuideLayout for Hindi and Punjabi pages: same structure, with the interface words in the page's language. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBlock from '../components/content/CtaBlock.astro';
import { UI, type Lang } from '../i18n/ui';
import type { Crumb, QA } from '../lib/seo';

interface Props {
  lang: Exclude<Lang, 'en'>;
  title: string;
  description: string;
  h1: string;
  lead: string;
  /** Empty on the language's home page. */
  crumbs: Crumb[];
  schema?: object[];
  faq?: QA[];
  related?: { href: string; label: string }[];
  cta: { heading: string; body: string; label: string; message: string };
  updated: string;
}
const { lang, title, description, h1, lead, crumbs, schema = [], faq = [], related = [], cta, updated } = Astro.props;
const ui = UI[lang];
// Dates in the page's own language and script, e.g. "4 अक्तूबर 2026".
const updatedText = new Date(`${updated}T00:00:00Z`).toLocaleDateString(ui.htmlLang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={title} description={description} crumbs={crumbs} schema={schema} lang={lang}>
  <article>
    <header class="wrap pt-8 pb-10 lg:pt-12 lg:pb-14">
      {crumbs.length > 0 && <Breadcrumbs items={[{ name: ui.homeCrumb, path: ui.home }, ...crumbs]} />}
      <h1 class="t-h1 mt-6 max-w-4xl">{h1}</h1>
      <p class="t-lead measure mt-5">{lead}</p>
      <p class="t-small mt-4 text-slate">{ui.updated}: {updatedText}</p>
      <div class="settle mt-10 border-t border-ink"></div>
    </header>

    <div class="wrap grid-12 pb-16 lg:pb-24">
      <div class="prose lg:col-span-7">
        <slot />
      </div>
      <aside class="lg:col-span-4 lg:col-start-9" aria-label="RSK Solar Energy">
        <div class="lg:sticky lg:top-28">
          <CtaBlock heading={cta.heading} body={cta.body} label={cta.label} message={cta.message} lang={lang} />
        </div>
      </aside>
    </div>

    {
      faq.length > 0 && (
        <div class="sec border-t border-rule bg-white">
          <div class="wrap grid-12">
            <div class="lg:col-span-8">
              <Faq items={faq} heading={ui.faq} />
            </div>
          </div>
        </div>
      )
    }

    {
      related.length > 0 && (
        <nav class="sec-tight border-t border-rule" aria-labelledby="related-h">
          <div class="wrap grid-12">
            <h2 id="related-h" class="t-h3 lg:col-span-3">
              {ui.readNext}
            </h2>
            <div class="lg:col-span-8 lg:col-start-5">
              <ul class="ruled">
                {related.map((r) => (
                  <li>
                    <a href={r.href} class="font-medium underline">
                      {r.label}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="t-small mt-6 text-slate">{ui.englishNote}</p>
            </div>
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>
