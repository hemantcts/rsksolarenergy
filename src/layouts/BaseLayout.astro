---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import DesktopCallButton from '../components/DesktopCallButton.astro';
import { BUSINESS } from '../config/business';
import { abs, breadcrumbs, graph, localBusiness, type Crumb } from '../lib/seo';
import { assertLaunchReady } from '../lib/launch-guard';

assertLaunchReady();

interface Props {
  /** Unique <title>. Keep under ~60 characters. */
  title: string;
  /** Unique meta description. Keep under ~155 characters. */
  description: string;
  /** Breadcrumb trail ending at this page. Home is added automatically. */
  crumbs?: Crumb[];
  /** Page-specific JSON-LD nodes (LocalBusiness and BreadcrumbList are added here). */
  schema?: object[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, crumbs = [], schema = [], ogType = 'website', ogImage = '/og-default.png', noindex = false } = Astro.props;
const canonical = abs(Astro.url.pathname);
const trail: Crumb[] = [{ name: 'Home', path: '/' }, ...crumbs];
const nodes = [localBusiness(), ...(crumbs.length ? [breadcrumbs(trail)] : []), ...schema];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <Font cssVariable="--font-plex-condensed" preload />
    <Font cssVariable="--font-plex-sans" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-plex-mono" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RSK Solar Energy: rooftop solar in Mohali and Punjab, priced after subsidy" />
    <meta name="twitter:card" content="summary_large_image" />
    {BUSINESS.social.x && <meta name="twitter:site" content={`@${new URL(BUSINESS.social.x).pathname.split('/')[1]}`} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />

    <meta name="theme-color" content="#0D1B2A" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" is:inline set:html={graph(nodes)} />
    <slot name="head" />

    {
      BUSINESS.gaMeasurementId && (
        // Google tag (gtag.js) — see BUSINESS.gaMeasurementId to change or remove.
        // Loaded lazily, after the browser is idle (or the page has loaded, as a fallback for
        // browsers without requestIdleCallback), rather than as a blocking <head> script.
        // gtag.js itself forces a synchronous layout reflow the moment it runs and is a heavy
        // script mostly unused on a simple pageview — measured directly in PageSpeed Insights,
        // both cost real LCP/TBT time when loaded in the critical path. Deferring it removes it
        // from that path entirely; the pageview still fires, just a moment later.
        <script is:inline define:vars={{ id: BUSINESS.gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          function loadGA() {
            if (window.__gaLoaded) return;
            window.__gaLoaded = true;
            const s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
            gtag('js', new Date());
            gtag('config', id);
          }
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadGA, { timeout: 4000 });
          } else {
            window.addEventListener('load', () => setTimeout(loadGA, 1000));
          }
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <DesktopCallButton />
    <script>
      // Counts WhatsApp and call taps, with the page and button they came from (files/DEPLOY.md).
      import '../scripts/taps';
    </script>
  </body>
</html>
