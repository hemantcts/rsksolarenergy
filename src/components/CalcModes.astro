---
/** Switch between the calculators: from a PSPCL bill, from appliances for a new house, or for battery systems. */
interface Props {
  current: 'bill' | 'house' | 'hybrid' | 'off-grid';
}
const { current } = Astro.props;
---

<nav class="calc-modes" aria-label="Choose a calculator">
  <a href="/solar-calculator/" aria-current={current === 'bill' ? 'page' : undefined}>
    I have an electricity bill
    <small>Size, subsidy and payback from your PSPCL bill</small>
  </a>
  <a href="/new-house-solar-calculator/" aria-current={current === 'house' ? 'page' : undefined}>
    I’m building or buying a new house
    <small>No bill yet: estimate from your appliances</small>
  </a>
  <a href="/hybrid-solar-calculator/" aria-current={current === 'hybrid' ? 'page' : undefined}>
    I need backup in power cuts
    <small>Hybrid: grid plus battery</small>
  </a>
  <a href="/off-grid-solar-calculator/" aria-current={current === 'off-grid' ? 'page' : undefined}>
    There is no grid connection
    <small>Off-grid: panels and batteries only</small>
  </a>
</nav>

<style>
.calc-modes {
  display: grid;
  grid-template-columns: 1fr;
  border: 1px solid var(--color-slate);
  border-radius: var(--radius-sm);
  background: var(--color-white);
}
.calc-modes a {
  display: grid;
  align-content: center;
  gap: 0.125rem;
  min-height: 3.5rem;
  padding: 0.625rem 0.875rem;
  font-weight: 500;
  font-size: 0.9375rem;
  line-height: 1.3;
  text-decoration: none;
}
.calc-modes a + a {
  border-top: 1px solid var(--color-slate);
}
@media (min-width: 40rem) {
  .calc-modes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .calc-modes a + a {
    border-top: 0;
  }
  .calc-modes a:nth-child(even) {
    border-left: 1px solid var(--color-slate);
  }
  .calc-modes a:nth-child(n + 3) {
    border-top: 1px solid var(--color-slate);
  }
}
.calc-modes a[aria-current='page'] {
  background: var(--color-ink);
  color: var(--color-white);
}
.calc-modes a:not([aria-current]):hover {
  background: var(--color-paper);
}
.calc-modes small {
  font-weight: 400;
  font-size: 0.8125rem;
  opacity: 0.8;
}
</style>
