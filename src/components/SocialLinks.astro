---
/** Renders only the profiles RSK has actually confirmed — never a placeholder link. */
import Icon from './Icon.astro';
import { BUSINESS } from '../config/business';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const links = [
  { key: 'facebook', href: BUSINESS.social.facebook, label: 'RSK Solar Energy on Facebook' },
  { key: 'instagram', href: BUSINESS.social.instagram, label: 'RSK Solar Energy on Instagram' },
  { key: 'youtube', href: BUSINESS.social.youtube, label: 'RSK Solar Energy on YouTube' },
  { key: 'x', href: BUSINESS.social.x, label: 'RSK Solar Energy on X (Twitter)' },
].filter((l): l is { key: 'facebook' | 'instagram' | 'youtube' | 'x'; href: string; label: string } => Boolean(l.href));
---

{
  links.length > 0 && (
    <ul class:list={['flex items-center gap-4', className]}>
      {links.map((l) => (
        <li>
          <a href={l.href} rel="noopener" target="_blank" aria-label={l.label} class="inline-flex">
            <Icon name={l.key} size={22} />
          </a>
        </li>
      ))}
    </ul>
  )
}
