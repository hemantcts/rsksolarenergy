---
/**
 * Illustration: a standalone solar water pump on a Punjab farm. A ground-mounted panel array feeds
 * the pump controller, which drives a submersible pump down the borewell; water comes up into the
 * field channel. Decorative, in the site's ink, green and accent yellow; water in a muted blue.
 * Styles live in src/styles/graphics.css.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Panel array: one wide tilted module block with a 5 × 2 cell grid.
const bl = [150, 150];
const br = [290, 150];
const tr = [312, 96];
const tl = [172, 96];
const lerp = (a: number[], b: number[], t: number) => [a[0]! + (b[0]! - a[0]!) * t, a[1]! + (b[1]! - a[1]!) * t];
const verticals = [0.2, 0.4, 0.6, 0.8].map((t) => [lerp(bl, br, t), lerp(tl, tr, t)]);
const mid = [lerp(bl, tl, 0.5), lerp(br, tr, 0.5)];
const outline = [bl, br, tr, tl].map((p) => p.join(',')).join(' ');
const sprouts = [26, 52, 78, 104, 130];
---

<svg class:list={['pump-art', className]} viewBox="0 0 480 320" aria-hidden="true" focusable="false">
  <rect x="10" y="210" width="460" height="106" class="soil" />
  <path d="M10 270 C60 262 110 278 160 270 S260 262 310 270 S410 278 470 270 V316 H10 Z" class="aquifer" />
  <path d="M10 270 C60 262 110 278 160 270 S260 262 310 270 S410 278 470 270" class="water-line" />
  <path d="M40 236 H96 M180 248 H240 M300 232 H344" class="strata" />
  <line x1="10" y1="210" x2="470" y2="210" class="ground" />

  <g transform="translate(72 60)">
    <g class="rays">
      {Array.from({ length: 8 }).map((_, i) => <line x1="0" y1="-28" x2="0" y2="-38" transform={`rotate(${i * 45})`} class="ray" />)}
    </g>
    <circle r="20" class="sun" />
  </g>

  {
    sprouts.map((x) => (
      <g transform={`translate(${x} 210)`}>
        <line x1="0" y1="0" x2="0" y2="-18" class="stem" />
        <ellipse cx="-5" cy="-12" rx="5" ry="2.4" transform="rotate(-30 -5 -12)" class="leaf" />
        <ellipse cx="5" cy="-17" rx="5" ry="2.4" transform="rotate(30 5 -17)" class="leaf" />
      </g>
    ))
  }

  <line x1="170" y1="150" x2="170" y2="210" class="leg" />
  <line x1="280" y1="150" x2="280" y2="210" class="leg" />
  <line x1="302" y1="104" x2="302" y2="210" class="leg" />
  <line x1="170" y1="186" x2="302" y2="150" class="brace" />
  <polygon points={outline} class="panel" />
  {verticals.map((l) => <line x1={l[0]![0]} y1={l[0]![1]} x2={l[1]![0]} y2={l[1]![1]} class="cell" />)}
  <line x1={mid[0]![0]} y1={mid[0]![1]} x2={mid[1]![0]} y2={mid[1]![1]} class="cell" />
  <line x1="182" y1="104" x2="214" y2="104" class="glint" />

  <path d="M306 118 C326 118 349 128 349 150" class="wire dash" />
  <line x1="349" y1="200" x2="349" y2="210" class="leg" />
  <rect x="330" y="150" width="38" height="50" rx="3" class="box" />
  <circle cx="349" cy="164" r="4" class="led" />
  <path d="M338 182 C342 176 346 176 350 182 S358 188 362 182" class="sine" />

  <rect x="388" y="196" width="14" height="92" class="casing" />
  <path d="M368 186 H395 V272" class="wire dash" />
  <rect x="384" y="272" width="22" height="30" rx="4" class="pump" />
  <path d="M395 272 V200" class="rise dash-up" />
  <path d="M402 200 H436 V212" class="pipe" />
  <rect x="420" y="212" width="50" height="10" class="channel" />
  <path d="M436 214 C436 222 432 226 432 232" class="drip dash-up" />
</svg>
