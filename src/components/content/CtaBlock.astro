---
import { PRIMARY_PHONE } from '../../config/business';
import WhatsAppButton from '../WhatsAppButton.astro';
import { siteInspectionMessage } from '../../lib/whatsapp';
import { UI, type Lang } from '../../i18n/ui';

interface Props {
  heading?: string;
  label?: string;
  message?: string;
  body?: string;
  showInspection?: boolean;
  /** Button wording on Hindi and Punjabi pages. */
  lang?: Lang;
}
const {
  heading = 'Send us your last electricity bill',
  label = 'Send my bill on WhatsApp',
  message = 'Hi RSK Solar Energy, I am sending my last electricity bill. Please tell me what size of solar system suits it and the cost after subsidy.',
  body = 'A photo is enough. We reply with the right size, the cost after subsidy and anything your connection needs first.',
  showInspection = true,
  lang = 'en',
} = Astro.props;
const ui = UI[lang];
---

<div class="not-prose border border-ink bg-white p-6 lg:p-8">
  <p class="t-h3">{heading}</p>
  <p class="mt-2 text-slate">{body}</p>
  <div class="mt-5 flex flex-col gap-3">
    <WhatsAppButton label={label} message={message} />
    {showInspection && <WhatsAppButton label={ui.inspection} message={siteInspectionMessage()} variant="secondary" />}
    <a class="btn btn-secondary" href={`tel:${PRIMARY_PHONE.tel}`}>{ui.call} {PRIMARY_PHONE.display}</a>
    <a class="btn-tertiary mt-1 self-start" href="/solar-calculator/">{ui.calculator}</a>
  </div>
</div>
