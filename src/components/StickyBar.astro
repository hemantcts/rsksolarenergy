---
/** Fixed bottom bar on mobile: WhatsApp | Call | Calculate. Replaces the contact page (DESIGN.md §6). */
import { PRIMARY_PHONE } from '../config/business';
import { whatsappUrl, billMessage } from '../lib/whatsapp';
import Icon from './Icon.astro';
---

<nav class="sticky-bar on-ink md:hidden" aria-label="Contact RSK Solar Energy">
  <a href={whatsappUrl(billMessage())} rel="noopener" target="_blank" class="is-primary">
    <Icon name="whatsapp" size={20} />
    <span>WhatsApp</span>
  </a>
  <a href={`tel:${PRIMARY_PHONE.tel}`}>
    <Icon name="phone" size={20} />
    <span>Call</span>
  </a>
  <a href="/solar-calculator/">
    <Icon name="calculator" size={20} />
    <span>Calculate</span>
  </a>
</nav>

<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    height: var(--sticky-bar);
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-ink);
    color: var(--color-white);
    border-top: 1px solid var(--color-slate);
    transition: transform 200ms ease;
  }
  @media (min-width: 48rem) {
    .sticky-bar {
      display: none;
    }
  }
  .sticky-bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 500;
    text-decoration: none;
  }
  .sticky-bar a + a {
    border-left: 1px solid var(--color-slate);
  }
  .sticky-bar .is-primary {
    background: var(--color-signal);
    color: var(--color-white);
  }
  /* Hidden while typing so it never covers the field (MOTION.md §3.3). */
  :global(body.is-typing) .sticky-bar {
    transform: translateY(100%);
  }
</style>

<script>
  import '../scripts/sticky-bar';
</script>
