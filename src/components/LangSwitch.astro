---
/** A slim bar under the header on any page that has a Hindi or Punjabi version: English · हिन्दी · ਪੰਜਾਬੀ. */
import { UI, type Lang } from '../i18n/ui';
import type { Alternate } from '../i18n/alternates';

interface Props {
  alternates: Alternate[];
  current: Lang;
}
const { alternates, current } = Astro.props;
---

<nav class="border-b border-rule bg-white" aria-label={UI[current].languages}>
  <ul class="wrap t-small flex h-10 items-center gap-x-5">
    {
      alternates.map((a) => (
        <li>
          {a.lang === current ? (
            <span class="font-medium" lang={UI[a.lang].htmlLang} aria-current="page">
              {UI[a.lang].name}
            </span>
          ) : (
            <a href={a.path} hreflang={UI[a.lang].htmlLang} lang={UI[a.lang].htmlLang} class="text-slate underline">
              {UI[a.lang].name}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
