---
/** Fixed bottom-right call button on desktop, mirroring StickyBar's mobile call action. */
import { PRIMARY_PHONE } from '../config/business';
import Icon from './Icon.astro';
---

<a href={`tel:${PRIMARY_PHONE.tel}`} class="desktop-call-btn hidden md:inline-flex" aria-label={`Call RSK Solar Energy at ${PRIMARY_PHONE.display}`}>
  <Icon name="phone" size={20} />
  <span>Call {PRIMARY_PHONE.display}</span>
</a>

<style>
  .desktop-call-btn {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 50;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.25rem;
    background: var(--color-signal);
    color: var(--color-white);
    font-weight: 500;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.2);
    transition:
      transform 150ms ease,
      background 150ms ease;
  }
  .desktop-call-btn:hover {
    background: var(--color-signal-hover);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .desktop-call-btn {
      transition: none;
    }
    .desktop-call-btn:hover {
      transform: none;
    }
  }
</style>
