---
import { whatsappUrl, GENERIC_MESSAGE } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  /** Say what happens: "Ask about a 3kW system on WhatsApp", not "Contact us". */
  label: string;
  message?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { label, message = GENERIC_MESSAGE, variant = 'primary', class: className } = Astro.props;
---

<a class:list={['btn', `btn-${variant}`, className]} href={whatsappUrl(message)} rel="noopener" target="_blank">
  <Icon name="whatsapp" size={20} />
  <span>{label}</span>
</a>
