---
/**
 * Contact strip (md and up), then logo, main navigation and the WhatsApp action.
 * Navigation was added at RSK's request; it replaces the earlier logo-and-CTA-only header
 * described in DESIGN.md §6. Menu data lives in src/data/nav.ts.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { BUSINESS, PRIMARY_PHONE, formatHours } from '../config/business';
import { CONTACT_LINK, NAV, type NavLink } from '../data/nav';
import { billMessage } from '../lib/whatsapp';
import RatingBadge from './RatingBadge.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';

const hours = formatHours();
const hoursText = hours ? [...hours.lines, ...(hours.closed ? [hours.closed] : [])].join(' · ') : null;
const here = Astro.url.pathname;
const inGroup = (links: NavLink[]) => links.some((l) => l.href === here);
---

<header>
  <div class="on-ink hidden bg-ink text-white md:block">
    <div class="wrap t-small flex h-10 items-center justify-between gap-6">
      <p class="text-rule">{BUSINESS.brand} distributor · Phase 8B, Mohali</p>
      <ul class="flex items-center gap-6">
        {
          hoursText && (
            <li class="hidden items-center gap-2 text-rule lg:flex">
              <Icon name="clock" size={15} />
              <span>{hoursText}</span>
            </li>
          )
        }
        <li><RatingBadge class="inline-flex" /></li>
        <li>
          <a href={`tel:${PRIMARY_PHONE.tel}`} class="inline-flex items-center gap-2 no-underline hover:underline">
            <Icon name="phone" size={15} />
            <span class="t-value">{PRIMARY_PHONE.display}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-b border-rule">
    <div class="wrap flex h-16 items-center justify-between gap-4 md:h-20">
      <a href="/" class="shrink-0" aria-label="RSK Solar Energy, home">
        <Image src={logo} alt="RSK Solar Energy" width={156} densities={[1, 2]} format="webp" loading="eager" fetchpriority="high" class="h-auto w-33 md:w-39" />
      </a>

      <nav class="hidden xl:block" aria-label="Main">
        <ul class="flex items-center">
          {
            NAV.map((g, i) => (
              <li class="nav-item" data-nav-item>
                <button type="button" class:list={['nav-trigger', { 'is-current': inGroup(g.links) }]} aria-expanded="false" aria-controls={`nav-panel-${i}`} data-nav-trigger>
                  <span>{g.label}</span>
                  <span class="nav-chevron">
                    <Icon name="chevron-down" size={18} />
                  </span>
                </button>
                <div class="nav-panel" id={`nav-panel-${i}`}>
                  <ul>
                    {g.links.map((l) => (
                      <li>
                        <a href={l.href} class="nav-panel-link" aria-current={l.href === here ? 'page' : undefined}>
                          <span class="block font-medium">{l.label}</span>
                          {l.note && <span class="t-small block text-slate">{l.note}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
          <li>
            <a href={CONTACT_LINK.href} class:list={['nav-trigger', { 'is-current': here === CONTACT_LINK.href }]} aria-current={here === CONTACT_LINK.href ? 'page' : undefined}>
              {CONTACT_LINK.label}
            </a>
          </li>
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <RatingBadge class="inline-flex md:hidden" compact />
        <WhatsAppButton label="WhatsApp us" message={billMessage()} class="hidden 2xl:inline-flex" />
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span class="menu-icon-open"><Icon name="menu" size={22} /></span>
          <span class="menu-icon-close"><Icon name="close" size={22} /></span>
          <span>Menu</span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="border-b border-rule bg-white xl:hidden" hidden data-mobile-menu>
    <nav class="wrap pb-8" aria-label="Main menu">
      <ul class="mobile-groups">
        {
          NAV.map((g) => (
            <li>
              <details open={inGroup(g.links)}>
                <summary>
                  <span>{g.label}</span>
                  <span class="nav-chevron">
                    <Icon name="chevron-down" size={20} />
                  </span>
                </summary>
                <ul class="pb-3">
                  {g.links.map((l) => (
                    <li>
                      <a href={l.href} class="mobile-link" aria-current={l.href === here ? 'page' : undefined}>
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
        <li><a href={CONTACT_LINK.href} class="mobile-plain">Contact and directions</a></li>
      </ul>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <WhatsAppButton label="Send your bill on WhatsApp" message={billMessage()} />
        <a class="btn btn-secondary" href={`tel:${PRIMARY_PHONE.tel}`}>
          <Icon name="phone" size={18} />
          <span>Call {PRIMARY_PHONE.display}</span>
        </a>
      </div>
      {hoursText && <p class="t-small mt-4 text-slate">Office hours: {hoursText}</p>}
    </nav>
  </div>
</header>

<style>
  .nav-item {
    position: relative;
  }
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.5rem 0.7rem;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }
  .nav-trigger:hover,
  .nav-item.is-open .nav-trigger {
    background: var(--color-white);
  }
  .nav-trigger.is-current {
    box-shadow: inset 0 -2px 0 var(--color-signal);
  }
  .nav-chevron {
    display: inline-flex;
    transition: transform 150ms ease;
  }
  .nav-item.is-open .nav-chevron,
  .mobile-groups details[open] .nav-chevron {
    transform: rotate(180deg);
  }

  .nav-panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 60;
    min-width: 17rem;
    padding: 0.5rem;
    background: var(--color-white);
    border: 1px solid var(--color-rule);
    border-top: 2px solid var(--color-ink);
    box-shadow: 0 12px 24px rgb(13 27 42 / 0.08);
  }
  /* The last dropdowns sit near the right edge; open them leftwards so they stay on screen. */
  .nav-item:nth-last-child(-n + 3) .nav-panel {
    left: auto;
    right: 0;
  }
  @media (hover: hover) {
    .nav-item:hover .nav-panel {
      display: block;
    }
  }
  .nav-item.is-open .nav-panel,
  .nav-item:has(:focus-visible) .nav-panel {
    display: block;
  }
  .nav-panel-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .nav-panel-link:hover,
  .nav-panel-link[aria-current='page'] {
    background: var(--color-paper);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    background: none;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    font-weight: 500;
    cursor: pointer;
  }
  @media (min-width: 80rem) {
    .menu-toggle {
      display: none;
    }
  }
  .menu-icon-open,
  .menu-icon-close {
    display: inline-flex;
  }
  .menu-icon-close,
  .menu-toggle[aria-expanded='true'] .menu-icon-open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-icon-close {
    display: inline-flex;
  }

  .mobile-groups > li {
    border-top: 1px solid var(--color-rule);
  }
  .mobile-groups summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.9rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .mobile-groups summary::-webkit-details-marker {
    display: none;
  }
  .mobile-link {
    display: block;
    padding: 0.6rem 0.25rem;
    text-decoration: none;
  }
  .mobile-link[aria-current='page'] {
    font-weight: 600;
    text-decoration: underline;
  }
  .mobile-plain {
    display: block;
    padding-block: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>

<script>
  import '../scripts/nav';
</script>
