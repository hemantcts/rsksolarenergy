---
import type { Crumb } from '../lib/seo';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="t-small text-slate">
  <ol class="flex flex-wrap gap-x-2">
    {
      items.map((c, i) => (
        <li class="flex gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={c.path} class="underline">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
