---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getImage } from 'astro:assets';
import { article, faqPage } from '../../lib/seo';
import { photoByName } from '../../data/photos';
import Callout from '../../components/content/Callout.astro';
import BlogPhoto from '../../components/content/BlogPhoto.astro';

// A post's own illustration, made when it was written, is src/assets/blog/<slug>.webp. Posts without
// one open on one of our installation photos, chosen by category.
const ILLUSTRATIONS = import.meta.glob<{ default: ImageMetadata }>('../../assets/blog/*.webp', { eager: true });
const CATEGORY_PHOTO: Record<string, string> = {
  'Subsidy and bills': 'rooftop-solar-panels-on-house-punjab',
  'Sizing and systems': 'rooftop-solar-array-home-punjab',
  'Hybrid, on-grid and off-grid': 'solar-inverter-and-electrical-panel-installed',
  'Solar pumps and agriculture': 'solar-pump-water-flowing-into-field-channel',
  'Panels and inverters': 'solar-panel-array-close-up-punjab',
  'Installation and maintenance': 'rooftop-solar-mounting-structure-punjab',
  Financing: 'rooftop-solar-panels-town-punjab',
  'Residential and commercial': 'solar-panel-canopy-commercial-punjab',
  'ROI and payback': 'rooftop-solar-panels-on-house-punjab',
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/blog/${entry.id}/`;
// Frontmatter `title` doubles as the <title> tag, so it carries the "| RSK Solar" suffix — strip
// it once and reuse everywhere a clean headline is needed (H1, breadcrumb, and the Article
// schema's `headline`, which had been getting the raw suffixed value).
const clean = (title: string) => title.replace(/ \| RSK.*$/, '');
const headline = clean(d.title);

const chosen = d.related.length
  ? d.related
  : [
      { href: '/solar-calculator/', label: 'Work out your own numbers in the calculator' },
      { href: '/pm-surya-ghar-subsidy-punjab/', label: 'PM Surya Ghar subsidy in Punjab' },
      { href: '/blog/', label: 'All guides' },
    ];
// Every guide also links to up to three others in its category, newest first, so none is left
// reachable only from the blog index.
const sameCategory = (await getCollection('blog'))
  .filter((p) => p.id !== entry.id && p.data.category === d.category && !chosen.some((r) => r.href === `/blog/${p.id}/`))
  .sort((a, b) => (b.data.updated ?? b.data.published).localeCompare(a.data.updated ?? a.data.published))
  .slice(0, 3)
  .map((p) => ({ href: `/blog/${p.id}/`, label: clean(p.data.title) }));
const related = [...chosen, ...sameCategory];

const own = ILLUSTRATIONS[`../../assets/blog/${entry.id}.webp`]?.default;
const photo = photoByName(CATEGORY_PHOTO[d.category]!)!;
const hero = own ? { src: own, alt: d.imageAlt ?? headline } : { src: photo.src, alt: photo.alt };
const og = await getImage({ src: hero.src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 75 });
---

<GuideLayout
  title={d.title}
  description={d.description}
  h1={headline}
  lead={d.description}
  crumbs={[
    { name: 'Guides', path: '/blog/' },
    { name: headline, path },
  ]}
  schema={[article({ title: headline, description: d.description, path, published: d.published, ...(d.updated ? { updated: d.updated } : {}) }), ...(d.faq.length ? [faqPage(d.faq)] : [])]}
  faq={d.faq}
  updated={d.updated ?? d.published}
  ogType="article"
  hero={hero}
  ogImage={og.src}
  ogImageAlt={hero.alt}
  related={related}
  {...(d.cta ? { cta: d.cta } : {})}
>
  <Content components={{ Callout, BlogPhoto }} />
</GuideLayout>
