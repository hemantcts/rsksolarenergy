---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { article, faqPage } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/blog/${entry.id}/`;
---

<GuideLayout
  title={d.title}
  description={d.description}
  h1={d.title.replace(/ \| RSK.*$/, '')}
  lead={d.description}
  crumbs={[
    { name: 'Guides', path: '/blog/' },
    { name: d.title.replace(/ \| RSK.*$/, ''), path },
  ]}
  schema={[article({ title: d.title, description: d.description, path, published: d.published, ...(d.updated ? { updated: d.updated } : {}) }), ...(d.faq.length ? [faqPage(d.faq)] : [])]}
  faq={d.faq}
  updated={d.updated ?? d.published}
  ogType="article"
  related={[
    { href: '/solar-calculator/', label: 'Work out your own numbers in the calculator' },
    { href: '/pm-surya-ghar-subsidy-punjab/', label: 'PM Surya Ghar subsidy in Punjab' },
    { href: '/blog/', label: 'All guides' },
  ]}
>
  <Content />
</GuideLayout>
