---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { article, faqPage } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/blog/${entry.id}/`;
// Frontmatter `title` doubles as the <title> tag, so it carries the "| RSK Solar" suffix — strip
// it once and reuse everywhere a clean headline is needed (H1, breadcrumb, and the Article
// schema's `headline`, which had been getting the raw suffixed value).
const headline = d.title.replace(/ \| RSK.*$/, '');
---

<GuideLayout
  title={d.title}
  description={d.description}
  h1={headline}
  lead={d.description}
  crumbs={[
    { name: 'Guides', path: '/blog/' },
    { name: headline, path },
  ]}
  schema={[article({ title: headline, description: d.description, path, published: d.published, ...(d.updated ? { updated: d.updated } : {}) }), ...(d.faq.length ? [faqPage(d.faq)] : [])]}
  faq={d.faq}
  updated={d.updated ?? d.published}
  ogType="article"
  related={d.related.length ? d.related : [
    { href: '/solar-calculator/', label: 'Work out your own numbers in the calculator' },
    { href: '/pm-surya-ghar-subsidy-punjab/', label: 'PM Surya Ghar subsidy in Punjab' },
    { href: '/blog/', label: 'All guides' },
  ]}
  {...(d.cta ? { cta: d.cta } : {})}
>
  <Content />
</GuideLayout>
