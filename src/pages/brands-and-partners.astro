---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBlock from '../components/content/CtaBlock.astro';
import { BUSINESS } from '../config/business';
import { BRAND_CATEGORIES } from '../data/brands';

const path = '/brands-and-partners/';
---

<BaseLayout
  title="Solar and Home Appliance Brands We Stock in Mohali"
  description="Every brand RSK Solar Energy stocks or installs alongside UTL Solar: power and solar equipment, fans and coolers, home appliances, and tubewell motors."
  crumbs={[{ name: 'Brands & Partners', path }]}
>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Brands & Partners', path }]} />
    <h1 class="t-h1 mt-6">Brands we stock</h1>
    <p class="t-lead measure mt-5">
      RSK Solar Energy is an authorised {BUSINESS.brand} distributor. Alongside solar equipment, we also stock the brands below, all available through the same enquiry.
    </p>
  </header>

  {
    BRAND_CATEGORIES.map((cat) => (
      <section class="sec-tight border-t border-rule" aria-labelledby={`cat-${cat.title.replace(/\s+/g, '-').toLowerCase()}`}>
        <div class="wrap grid-12">
          <div class="lg:col-span-4">
            <h2 id={`cat-${cat.title.replace(/\s+/g, '-').toLowerCase()}`} class="t-h2">
              {cat.title}
            </h2>
            <p class="mt-4 text-slate">{cat.blurb}</p>
          </div>
          <ul class="lg:col-span-7 lg:col-start-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
            {cat.brands.map((b) => (
              <li class="flex h-24 items-center justify-center border border-rule bg-white p-4">
                {b.logo ? <Image src={b.logo} alt={b.name} width={200} class="h-auto max-h-14 w-auto max-w-full object-contain" /> : <span class="t-h3 text-center">{b.name}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="sec-tight bg-white border-t border-rule" aria-labelledby="cta-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-7">
        <h2 id="cta-h" class="t-h2">Looking for something from this list?</h2>
        <p class="mt-3 text-slate">Ask us on WhatsApp and we'll confirm availability and price for any product across these brands.</p>
      </div>
      <div class="mt-6 lg:col-span-4 lg:col-start-9 lg:mt-0">
        <CtaBlock heading="Ask about a product" label="Ask on WhatsApp" body="Tell us the brand and product, we'll confirm availability and price." />
      </div>
    </div>
  </section>
</BaseLayout>
