---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBlock from '../../components/content/CtaBlock.astro';
import { Image } from 'astro:assets';
import { PRODUCTS, PRODUCT_IMAGES, categoryName, productsIn, type Product } from '../../data/products';
import { productMessage } from '../../lib/whatsapp';
import { product as productSchema, abs, clampWords, fitSuffix } from '../../lib/seo';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Product };
const path = `/products/${p.slug}/`;
const cat = categoryName(p.category);
const related = productsIn(p.category).filter((x) => x.slug !== p.slug).slice(0, 5);
const intro = p.summary || `${p.title} from ${p.brand}, supplied by RSK Solar Energy in Mohali.`;
const descFull = `${p.title}${p.model ? ` (${p.model})` : ''}: ${p.brand} specifications, features and warranty. Ask RSK Solar Energy, Mohali, for price and stock on WhatsApp.`;
const descShort = `${p.title}: ${p.brand} specifications and warranty. Ask RSK Solar Energy, Mohali, for price and stock.`;
const description = [descFull, descShort].find((d) => d.length <= 160) ?? clampWords(descShort, 160);
// Keep the product name — the actual keyword — whole, and append the longest brand/location
// suffix that still fits. A blind slice was cutting it mid-word ("RSK Solar Energy Moh").
const title = p.title + fitSuffix(p.title, [' | UTL Solar | RSK Solar Energy Mohali', ' | RSK Solar Energy Mohali', ' | RSK Solar Mohali', ' | RSK Solar'], 60);
const moreParas = p.description.filter((d) => !intro.startsWith(d.slice(0, 60)));
const hasColumns = !!p.specs?.columns?.length;
const isNumeric = (v: string) => /^[<>≥≤~±]?\s*[\d.,/×x*\-–% ]+\s*(v|a|w|kg|mm|ah|%|°c|v\s*dc|hz|kva|va|months?|years?|units per day|sqft|hr|ma)?[*]?$/i.test(v.trim());
---

<BaseLayout
  title={title}
  description={description}
  crumbs={[
    { name: 'Products', path: '/products/' },
    { name: p.title, path },
  ]}
  schema={[productSchema({ ...p, summary: intro, category: cat, image: PRODUCT_IMAGES[p.slug] ? abs(PRODUCT_IMAGES[p.slug].src) : undefined })]}
>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Products', path: '/products/' },
        { name: cat, path: `/products/${p.category}/` },
        { name: p.title, path },
      ]}
    />
    <h1 class="t-h1 mt-6 max-w-4xl">{p.title}</h1>
    <p class="mt-3 text-slate">
      {p.brand}
      {p.model && (
        <>
          , model <span class="t-value text-ink">{p.model}</span>
        </>
      )}
    </p>
    <p class="t-lead measure mt-5">{intro}</p>
  </header>

  <div class="wrap grid-12 pb-16 lg:pb-24">
    {
      PRODUCT_IMAGES[p.slug] && (
        <div class="lg:col-span-4 lg:col-start-9 lg:row-start-1 lg:order-2 mb-8 lg:mb-0">
          <div class="border border-rule bg-white lg:sticky lg:top-8">
            <Image src={PRODUCT_IMAGES[p.slug]} alt={`${p.title}, ${p.brand}${p.model ? ` model ${p.model}` : ''}`} width={480} height={480} loading="eager" fetchpriority="high" class="aspect-square w-full object-contain p-6" />
          </div>
        </div>
      )
    }
    <div class="lg:col-span-7">
      {
        p.specs && (
          <section aria-labelledby="spec-h">
            <h2 id="spec-h" class="t-h2">
              Specifications
            </h2>
            <div class="table-scroll mt-6">
              <table class="spec-table">
                {hasColumns && (
                  <thead>
                    <tr>
                      <th scope="col">Parameter</th>
                      {p.specs.columns!.map((c) => (
                        <th scope="col" class="num">
                          {c}
                        </th>
                      ))}
                    </tr>
                  </thead>
                )}
                <tbody>
                  {p.specs.rows.map((r) =>
                    'section' in r ? (
                      <tr class="section">
                        <th scope="colgroup" colspan={hasColumns ? p.specs!.columns!.length + 1 : 2}>
                          {r.section}
                        </th>
                      </tr>
                    ) : (
                      <tr>
                        <th scope="row">{r.label}</th>
                        {r.values.map((v) => (
                          <td class={isNumeric(v) ? 'num' : 'text-right'}>{v}</td>
                        ))}
                      </tr>
                    ),
                  )}
                </tbody>
              </table>
            </div>
            <p class="t-small mt-3 text-slate">As published by {p.brand}. We confirm figures that matter for your design against the current datasheet before you order.</p>
          </section>
        )
      }

      {
        p.features.length > 0 && (
          <section class="mt-14" aria-labelledby="feat-h">
            <h2 id="feat-h" class="t-h2">
              Features
            </h2>
            <ul class="ruled mt-6">
              {p.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        moreParas.length > 0 && (
          <section class="prose mt-14" aria-labelledby="about-h">
            <h2 id="about-h">About this product</h2>
            {moreParas.map((d) => (
              <p>{d}</p>
            ))}
          </section>
        )
      }

      {
        !p.specs && p.features.length === 0 && (
          <p class="mt-2 border-l-2 border-ink pl-4">
            Full specifications for this product are available on request. Ask on WhatsApp and we send the current datasheet.
          </p>
        )
      }
    </div>

    <aside class="lg:col-span-4 lg:col-start-9" aria-label="Price and availability">
      <div class="lg:sticky lg:top-8">
        <CtaBlock
          heading="Price and availability"
          body="We do not sell online. Ask on WhatsApp and we reply with the current price and stock, and whether it suits your system."
          label="Ask the discounted price on WhatsApp"
          message={productMessage(p.title, p.model ?? undefined)}
        />
        {
          related.length > 0 && (
            <nav class="mt-10" aria-labelledby="rel-h">
              <h2 id="rel-h" class="t-h3">
                More {cat.toLowerCase()}
              </h2>
              <ul class="ruled mt-4">
                {related.map((r) => (
                  <li class="py-3">
                    <a href={`/products/${r.slug}/`} class="underline">
                      {r.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </aside>
  </div>
</BaseLayout>
