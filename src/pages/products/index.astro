---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { CATEGORIES, PRODUCTS, PRODUCT_IMAGES, productsIn } from '../../data/products';
import { abs } from '../../lib/seo';

const itemList = {
  '@type': 'ItemList',
  name: 'UTL Solar product categories supplied by RSK Solar Energy',
  numberOfItems: CATEGORIES.length,
  itemListElement: CATEGORIES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/products/${c.id}/`), name: c.name })),
};
---

<BaseLayout
  title="Solar Products Dealer and Distributor in Punjab"
  description={`${PRODUCTS.length} UTL Solar products from RSK Solar Energy in Mohali, supplied across Punjab: panels, inverters and PCUs, batteries, charge controllers and complete kits.`}
  crumbs={[{ name: 'Products', path: '/products/' }]}
  schema={[itemList]}
>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Products', path: '/products/' }]} />
    <div class="grid-12 mt-6 items-end">
      <div class="lg:col-span-7">
        <h1 class="t-h1">UTL Solar products</h1>
        <p class="t-lead mt-5">
          {PRODUCTS.length} products from the UTL range, across {CATEGORIES.length} categories, each with its full specification. We do not sell online: ask on WhatsApp and we reply with today's price and stock.
        </p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <WhatsAppButton label="Ask for a price on WhatsApp" message="Hi RSK Solar Energy, I would like prices and stock for UTL products. Items and quantities: " />
      </div>
    </div>
  </header>

  <section class="sec-tight bg-white">
    <div class="wrap">
      <ul class="ruled">
        {
          CATEGORIES.map((c) => {
            const items = productsIn(c.id);
            const sample = items.find((p) => PRODUCT_IMAGES[p.slug]);
            return (
              <li>
                <a href={`/products/${c.id}/`} class="grid grid-cols-[auto_1fr_auto] items-center gap-x-5 no-underline">
                  {sample ? (
                    <span class="block h-16 w-16 shrink-0 border border-rule bg-white">
                      <Image src={PRODUCT_IMAGES[sample.slug]} alt="" width={128} height={128} loading="lazy" class="aspect-square h-full w-full object-contain p-1.5" />
                    </span>
                  ) : (
                    <span class="block h-16 w-16 shrink-0" aria-hidden="true" />
                  )}
                  <span>
                    <span class="t-h3 block underline decoration-rule">{c.name}</span>
                    <span class="mt-1 block text-slate">{c.blurb}</span>
                  </span>
                  <span class="t-value text-slate">{items.length}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>
