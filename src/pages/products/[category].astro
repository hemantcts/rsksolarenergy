---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { CATEGORIES, PRODUCT_IMAGES, keyFacts, productsIn, type ProductCategory } from '../../data/products';
import { productMessage, whatsappUrl } from '../../lib/whatsapp';
import { abs, clampWords } from '../../lib/seo';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.id }, props: { c } }));
}

const { c } = Astro.props as { c: (typeof CATEGORIES)[number] };
const category = c.id as ProductCategory;
const path = `/products/${category}/`;
const products = productsIn(category);

const itemList = {
  '@type': 'ItemList',
  name: `${c.name}: UTL Solar products supplied by RSK Solar Energy`,
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/products/${p.slug}/`), name: p.title })),
};

// Where we are comes before the specifics, because the description is clamped at 160 characters and
// whatever sits at the end is what gets cut. The titles of these six pages name Punjab, so the
// description is where Mohali is said.
// Only the first letter drops, or "PCUs" comes out as "pcus".
const lowerName = c.name.charAt(0).toLowerCase() + c.name.slice(1);
const description = clampWords(`${products.length} ${lowerName} from UTL Solar, stocked in Mohali and supplied across Punjab. ${c.blurb}`, 160);
---

<BaseLayout
  title={c.title}
  description={description}
  crumbs={[{ name: 'Products', path: '/products/' }, { name: c.name, path }]}
  schema={[itemList]}
>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Products', path: '/products/' }, { name: c.name, path }]} />
    <div class="grid-12 mt-6 items-end">
      <div class="lg:col-span-7">
        <h1 class="t-h1">{c.heading ?? c.name}</h1>
        <p class="t-lead mt-5">{c.blurb}</p>
        <p class="mt-3 text-slate">{products.length} products in this category. We do not sell online: ask on WhatsApp and we reply with today's price and stock.</p>
        {
          c.compare?.length ? (
            <p class="t-small mt-3 text-slate">
              Weighing UTL against another brand? Compared from each brand's own figures:{' '}
              {c.compare.map((cmp, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={cmp.href} class="underline">
                    UTL vs {cmp.brand}
                  </a>
                </>
              ))}
              .
            </p>
          ) : null
        }
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <WhatsAppButton label="Ask for a price on WhatsApp" message={`Hi RSK Solar Energy, I would like prices and stock for ${c.name.toLowerCase()}. Items and quantities: `} />
      </div>
    </div>
    <nav aria-label="Other categories" class="mt-10 border-t border-ink pt-4">
      <ul class="t-small flex flex-wrap gap-x-6 gap-y-2">
        {
          CATEGORIES.map((other) => (
            <li>
              {other.id === category ? (
                <span class="font-semibold">{other.name}</span>
              ) : (
                <a href={`/products/${other.id}/`} class="underline">
                  {other.name}
                </a>
              )}{' '}
              <span class="t-value text-slate">{productsIn(other.id).length}</span>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <section class="sec-tight bg-white">
    <div class="wrap">
      <ul class="ruled">
        {
          products.map((p) => (
            <li class="grid gap-x-6 gap-y-3 md:grid-cols-12">
              <a href={`/products/${p.slug}/`} class="block w-20 shrink-0 border border-rule bg-white md:col-span-2 md:w-full" aria-hidden="true" tabindex="-1">
                {PRODUCT_IMAGES[p.slug] && <Image src={PRODUCT_IMAGES[p.slug]} alt="" width={160} height={160} loading="lazy" class="aspect-square w-full object-contain p-2" />}
              </a>
              <div class="md:col-span-3 min-w-0">
                <a href={`/products/${p.slug}/`} class="t-h3 underline decoration-rule underline-offset-4 hover:decoration-ink">
                  {p.title}
                </a>
                {p.model && <span class="t-small mt-1 block text-slate">Model <span class="t-value text-ink">{p.model}</span></span>}
              </div>
              <dl class="t-small grid grid-cols-[auto_1fr] content-start gap-x-4 gap-y-1 md:col-span-4">
                {keyFacts(p).map((f) => (
                  <>
                    <dt class="text-slate">{f.label}</dt>
                    <dd class="t-value">{f.value}</dd>
                  </>
                ))}
              </dl>
              <div class="md:col-span-3 md:text-right">
                <a href={whatsappUrl(productMessage(p.title, p.model ?? undefined, `/products/${p.slug}/`))} class="btn-chip t-small" rel="noopener" target="_blank">
                  Ask Discounted Price
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
