---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBlock from '../components/content/CtaBlock.astro';
import { BUSINESS } from '../config/business';
import { REVIEWS, reviewMonth } from '../data/reviews';
import { abs } from '../lib/seo';
import rooftopHouse from '../assets/installations/rooftop-solar-panels-on-house-punjab.jpg';
import rooftopInProgress from '../assets/installations/rooftop-solar-installation-in-progress-punjab.jpg';
import pumpHouseInverter from '../assets/installations/utl-solar-inverter-wall-mounted-pump-house.jpg';
import groundArrayFarm from '../assets/installations/ground-mounted-solar-array-farm-punjab.jpg';
import pumpChannel from '../assets/installations/solar-pump-water-flowing-into-field-channel.jpg';
import arrayOverShed from '../assets/installations/solar-array-over-farm-shed-punjab.jpg';
import tubewellDischarge from '../assets/installations/solar-tubewell-pump-water-discharge-punjab.jpg';
import onGridInverter from '../assets/installations/utl-solar-on-grid-inverter-installed.jpg';
import rooftopTown from '../assets/installations/rooftop-solar-panels-town-punjab.jpg';
import canopyCommercial from '../assets/installations/solar-panel-canopy-commercial-punjab.jpg';
import groundRows from '../assets/installations/ground-mounted-solar-panel-rows-punjab.jpg';
import arrayCloseUp from '../assets/installations/solar-panel-array-close-up-punjab.jpg';
import rooftopHome from '../assets/installations/rooftop-solar-array-home-punjab.jpg';
import inverterAndPanel from '../assets/installations/solar-inverter-and-electrical-panel-installed.jpg';
import mountingStructure from '../assets/installations/rooftop-solar-mounting-structure-punjab.jpg';
import rooftopBeingFitted from '../assets/installations/rooftop-solar-panels-being-fitted-punjab.jpg';

/**
 * Stills from RSK Solar Energy's own job videos, confirmed as its own work on 26 September 2026.
 *
 * The captions say what is in the frame and nothing else. Where a job is, how big it is and whose
 * roof it sits on are not in the footage, so they are not claimed here. Anything more specific has
 * to come from RSK Solar Energy.
 */
/**
 * Clips from the same jobs, served from this site rather than a third party.
 *
 * Every one is `preload="none"` behind a poster image, so a visitor downloads nothing until they
 * press play. That is what makes self-hosting eight videos reasonable on shared hosting: the page
 * costs the same to load whether they are here or not.
 */
const clips = [
  { file: '09-solar-pump-water-into-field-channel', poster: pumpChannel, name: 'Solar pump running into a field channel', description: 'Water from a solar-powered tubewell running out into the concrete field channel.' },
  { file: '07-pole-mounted-solar-array-farmland', poster: groundArrayFarm, name: 'Pole-mounted solar array on farmland', description: 'A pole-mounted array standing in a field, feeding a pump.' },
  { file: '11-solar-tubewell-water-discharge', poster: tubewellDischarge, name: 'Solar tubewell discharging onto a field', description: 'Discharge from a solar tubewell pump onto ploughed ground.' },
  { file: '04-rooftop-solar-panels-on-homes', poster: rooftopHouse, name: 'Rooftop solar panels on a house', description: 'A finished residential rooftop array on a raised frame.' },
  { file: '06-pump-house-inverter-and-solar-array', poster: pumpHouseInverter, name: 'UTL inverter in a pump house', description: 'The UTL inverter and controls inside a pump house, with the array outside.' },
  { file: '10-solar-array-over-farm-shed', poster: arrayOverShed, name: 'Solar array over a farm shed', description: 'Panels mounted over a shed so the ground underneath stays usable.' },
  { file: '03-rooftop-solar-panel-installation', poster: rooftopBeingFitted, name: 'Rooftop panels going on', description: 'Modules being fitted to the mounting structure on a roof.' },
  { file: '27-rooftop-solar-mounting-structure', poster: mountingStructure, name: 'Rooftop mounting structure', description: 'The galvanised structure on a rooftop before the modules go on.' },
];

// Posters are generated at build time so they are WebP and the right size, like every other image.
const clipsWithPosters = await Promise.all(
  clips.map(async (clip) => ({ ...clip, posterUrl: (await getImage({ src: clip.poster, width: 640, format: 'webp' })).src })),
);

const videoSchema = clipsWithPosters.map((clip) => ({
  '@type': 'VideoObject',
  name: clip.name,
  description: clip.description,
  thumbnailUrl: abs(clip.posterUrl),
  contentUrl: abs(`/videos/${clip.file}.mp4`),
  uploadDate: '2026-09-26',
  isFamilyFriendly: true,
  publisher: { '@id': `${BUSINESS.url}#business` },
}));

const photos = [
  { src: rooftopHouse, alt: 'Rooftop solar array on a house in Punjab, the panels raised on a steel frame above the roof slab', caption: 'A home array on a raised frame, which leaves the roof usable underneath.' },
  { src: pumpChannel, alt: 'Water flowing from a solar pump into a concrete field channel in Punjab', caption: 'A solar pump running into the field channel.' },
  { src: pumpHouseInverter, alt: 'UTL Solar inverter mounted on the wall of a pump house, with conduit running out to the array', caption: 'A UTL inverter in a pump house, the DC run coming in from the array.' },
  { src: groundArrayFarm, alt: 'Pole-mounted solar array standing in a field in Punjab', caption: 'A pole-mounted array on farmland.' },
  { src: arrayOverShed, alt: 'Solar panels mounted over a farm shed in Punjab with a tractor trailer parked underneath', caption: 'Panels over a shed, so the ground underneath stays in use.' },
  { src: tubewellDischarge, alt: 'Water discharging from a solar tubewell pump onto a ploughed field in Punjab', caption: 'Discharge from a solar tubewell.' },
  { src: rooftopInProgress, alt: 'Solar panels being fitted on a house roof in Punjab, a ladder against the wall', caption: 'Mid-installation. The structure goes up first, then the modules.' },
  { src: canopyCommercial, alt: 'Large solar panel canopy covering an open area', caption: 'A canopy array: shade below, generation above.' },
  { src: groundRows, alt: 'Rows of ground-mounted solar panels on farmland in Punjab', caption: 'Ground-mounted rows.' },
  { src: onGridInverter, alt: 'UTL Solar on-grid inverter installed on an interior wall', caption: 'An on-grid inverter, mounted indoors.' },
  { src: rooftopTown, alt: 'Rooftop solar panels on a building with a town behind them', caption: 'A rooftop array above the rooftops.' },
  { src: inverterAndPanel, alt: 'Solar inverter installed beside an electrical distribution box', caption: 'Inverter and distribution board.' },
  { src: rooftopHome, alt: 'Solar array across a house rooftop in Punjab', caption: 'A home rooftop, filled.' },
  { src: arrayCloseUp, alt: 'Close view along a row of solar panels showing the mounting rails underneath', caption: 'Along the rails.' },
  { src: mountingStructure, alt: 'Galvanised mounting structure on a rooftop, ready for solar panels', caption: 'The structure, before the modules go on.' },
];

const path = '/installations/';
const withInstall = REVIEWS.filter((r) => r.install);

const byType = [
  { name: 'Residential on-grid & hybrid', href: '/solar-calculator/', blurb: `${BUSINESS.installs.residential} homes fitted, from on-grid systems sized to the bill to hybrid systems with battery backup.` },
  { name: 'Commercial & industrial', href: '/commercial-solar-punjab/', blurb: `${BUSINESS.installs.commercial} installations for shops, offices, schools and factories.` },
  { name: 'Solar water pumps', href: '/solar-pumps/', blurb: `${BUSINESS.installs.solarPumps} tubewell and irrigation pump installations for farmers.` },
  { name: 'Housing societies', href: '/housing-society-solar/', blurb: 'Common-area systems for RWAs and housing societies, with the society subsidy applied.' },
];
---

<BaseLayout
  title="Solar Installations in Mohali and Punjab"
  description={`${BUSINESS.installs.commercial} commercial installations, ${BUSINESS.installs.residential} residential, ${BUSINESS.installs.solarPumps} solar pumps: RSK Solar Energy's installation record in Mohali and Punjab.`}
  crumbs={[{ name: 'Installations', path }]}
  schema={videoSchema}
>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Installations', path }]} />
    <h1 class="t-h1 mt-6">Solar installations in Mohali and Punjab</h1>
    <p class="t-lead measure mt-5">
      What RSK Solar Energy has installed, by the numbers, as of {BUSINESS.installs.asOf}, and photographs from the jobs themselves. Every figure here is a confirmed count.
    </p>
  </header>

  <section class="sec-tight bg-white" aria-labelledby="by-type-h">
    <div class="wrap grid-12">
      <h2 id="by-type-h" class="sr-only">Installations by type</h2>
      <ul class="ruled lg:col-span-12">
        {
          byType.map((t) => (
            <li>
              <a href={t.href} class="grid grid-cols-[1fr_auto] gap-x-6 no-underline">
                <span>
                  <span class="t-h3 block underline decoration-rule">{t.name}</span>
                  <span class="mt-1 block text-slate">{t.blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec-open bg-white" aria-labelledby="clips-h">
    <div class="wrap">
      <h2 id="clips-h" class="t-h2">Watch the work</h2>
      <p class="measure mt-4 text-slate">
        Short clips from our own jobs. Nothing downloads until you press play, so the page stays
        quick whether you watch them or not.
      </p>
      <ul class="mt-8 grid gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {
          clipsWithPosters.map((clip) => (
            <li>
              <figure>
                <video
                  class="aspect-video w-full border border-rule bg-ink"
                  src={`/videos/${clip.file}.mp4`}
                  poster={clip.posterUrl}
                  preload="none"
                  controls
                  playsinline
                  aria-label={clip.name}
                />
                <figcaption class="t-small mt-2 text-slate">{clip.description}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec-open" aria-labelledby="photos-h">
    <div class="wrap">
      <h2 id="photos-h" class="t-h2">On the job</h2>
      <p class="measure mt-4 text-slate">
        Photographs from our own installations: rooftops around the Tricity, tubewell pumps out on
        farmland, and the inverters and boards behind them. No stock photography, on this page or
        anywhere else on this site.
      </p>
      <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3">
        {
          photos.map((photo, i) => (
            <li>
              <figure>
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[320, 640, 960]}
                  sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 33vw, 50vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  class="aspect-[4/3] w-full border border-rule object-cover"
                />
                <figcaption class="t-small mt-2 text-slate">{photo.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    withInstall.length > 0 && (
      <section class="on-ink sec-open bg-ink text-white" aria-labelledby="proof-h">
        <div class="wrap grid-12">
          <div class="lg:col-span-4">
            <h2 id="proof-h" class="t-h2">
              Real installs, named by the customer
            </h2>
            <p class="mt-4 text-rule">
              A handful of our Google reviews name the exact system installed. Reproduced word for word. See every review on the <a href="/reviews/" class="underline">reviews page</a>.
            </p>
          </div>
          <ul class="ruled lg:col-span-7 lg:col-start-6">
            {withInstall.map((r) => (
              <li class="py-6">
                <p class="t-value">{r.install}</p>
                <blockquote class="mt-2">
                  <p class="text-rule">“{r.text}”</p>
                </blockquote>
                <p class="t-small mt-3 text-rule">
                  {r.name}, Google review, {reviewMonth(r.date)}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="sec-tight border-t border-rule bg-white" aria-labelledby="cta-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-7">
        <h2 id="cta-h" class="t-h2">Considering an installation?</h2>
        <p class="mt-3 text-slate">Send your bill for a remote estimate, or book a free site visit. Either way, we quote before any work starts.</p>
      </div>
      <aside class="mt-8 lg:col-span-4 lg:col-start-9 lg:mt-0">
        <CtaBlock />
      </aside>
    </div>
  </section>
</BaseLayout>
