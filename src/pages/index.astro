---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import RatingBadge from '../components/RatingBadge.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SizeTable from '../components/content/SizeTable.astro';
import utlLogo from '../assets/brand/utl-logo.png';
import kangLogo from '../assets/brand/kang-logo.png';
import googleLogo from '../assets/brand/google-logo.png';
import justdialLogo from '../assets/brand/justdial-logo.png';
import { BUSINESS, PRIMARY_PHONE } from '../config/business';
import { SOLAR_CONFIG } from '../config/solar-config';
import { monthlyBill } from '../lib/calculator/tariff';
import { digits, inr } from '../lib/calculator/format';
import { REVIEWS, reviewMonth } from '../data/reviews';
import { CATEGORIES, PRODUCTS, PRODUCT_IMAGES, productsIn, type ProductCategory } from '../data/products';
import { CITIES, cityPath } from '../data/locations';
import { BRAND_CATEGORIES } from '../data/brands';
import { VIDEOS, youtubeThumbnail } from '../data/videos';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import RooftopSolarArt from '../components/art/RooftopSolarArt.astro';
import officePhoto from '../assets/office/rsk-solar-energy-office-mohali.jpg';
import panelsAndBatteries from '../assets/office/warehouse-panels-and-batteries.jpg';
import pcusAndInverters from '../assets/office/warehouse-pcus-and-inverters.jpg';
import meetingCabin from '../assets/office/office-meeting-cabin.jpg';
import { billMessage, siteInspectionMessage } from '../lib/whatsapp';
import { website } from '../lib/seo';

const cfg = SOLAR_CONFIG;
const threshold = cfg.freeUnits.perMonth;
const billAt = (u: number) => monthlyBill(u, { category: 'domestic', scheme: 'general', loadKw: 5, config: cfg }).total;
const bill320 = billAt(320);
const bill700 = billAt(700);
const minOnGridKw = cfg.sizing.minKwByType['on-grid'];
const [d0, d1] = cfg.subsidy.disbursementDays;
const reviews = REVIEWS.slice(0, 4);
// One teaser tile per non-solar brand, skipping UTL Solar (already shown above). The full list
// lives on /brands-and-partners/.
const brandTeaser = BRAND_CATEGORIES.flatMap((c) => c.brands).filter((b) => b.name !== 'UTL Solar');

// A recognisable, real product photo for each catalogue category. Falls back to the first product
// with a photo if a featured slug is ever renamed.
const FEATURED: Record<ProductCategory, string> = {
  'solar-systems': '3kw-48v-hybrid-solar-system',
  'solar-panels': '545-watt-topcon-bifacial-solar-panel',
  inverters: 'gamma-plus-mppt-solar-inverter-3-kva-24-volt-lithium',
  batteries: 'utl-150ah-solar-inverter-battery-ust-1560',
  'charge-controllers': 'r-mppt-solar-management-unit-12v-24v-40a',
  'ev-chargers': 'ev-battery-charger-48v-20a',
  'lighting-and-appliances': 'solar-led-lightning-system',
};
const featured = CATEGORIES.map((c) => {
  const inCategory = productsIn(c.id);
  const product = inCategory.find((p) => p.slug === FEATURED[c.id] && PRODUCT_IMAGES[p.slug]) ?? inCategory.find((p) => PRODUCT_IMAGES[p.slug]);
  const image = product ? PRODUCT_IMAGES[product.slug] : undefined;
  return { c, product, image, count: inCategory.length };
});

const directCities = CITIES.filter((c) => c.tier === 'direct');
const partnerCities = CITIES.filter((c) => c.tier === 'partner');

// "Solar panel dealer/distributor in Mohali" is the dominant real search pattern for this niche
// (it's what Sulekha, Justdial and IndiaMart rank pages for), so the title and H1 lead with it.
const title = 'Solar Panel Dealer & Distributor in Mohali | RSK Solar Energy';
const description = `UTL Solar dealer and distributor in Mohali, Punjab. On-grid, hybrid and off-grid rooftop solar systems for homes, businesses and housing societies in Tricity.`;
---

<BaseLayout title={title} description={description} schema={[website()]}>
  <!-- Hero: the calculator is the hero (DESIGN.md §6). -->
  <section class="wrap">
    <div class="grid-12 lg:items-stretch">
      <div class="pt-10 pb-12 lg:col-span-7 lg:pt-16 lg:pb-20 lg:pr-6">
        <h1 class="t-display max-w-[16ch]">Solar panel dealer &amp; distributor in Mohali, Punjab</h1>
        <p class="t-lead mt-6 max-w-xl">
          Enter your PSPCL bill. We size the system, take off the PM Surya Ghar subsidy and show your payback, for homes and businesses in Mohali, Tricity and Punjab. If solar will not pay back for you, the calculator says so.
        </p>
        <div class="settle mt-6 border-b border-rule pb-6">
          <ul class="t-small flex flex-wrap gap-x-6 gap-y-2 text-slate">
            <li>{BUSINESS.brand} distributor, Phase 8B Mohali</li>
            <li><RatingBadge class="inline-flex" /></li>
            <li>Since {BUSINESS.foundedYear}</li>
          </ul>
        </div>
        <div class="mt-8">
          <Calculator variant="hero" id="hero-calc" />
        </div>
      </div>

      <aside class="on-ink bleed-x bleed-right-lg bg-ink text-white lg:col-span-5" aria-labelledby="identity-panel-h">
        <div class="cell-grid h-full lg:grid-rows-[repeat(7,auto)_1fr]">
          <div class="col-span-4 px-6 pt-10 pb-8 lg:px-10 lg:pt-16">
            <Image src={utlLogo} alt="UTL Solar" width={200} class="h-auto w-28 bg-white p-1.5" />
            <p class="t-small mt-3 text-rule">{BUSINESS.brand} distributor</p>
            <h2 id="identity-panel-h" class="t-h2 mt-2">RSK Solar Energy</h2>
            <p class="mt-3 text-rule">
              We supply and install {BUSINESS.brand} rooftop solar from Phase 8B, Mohali: on-grid, hybrid and off-grid systems, plus panels, inverters, batteries and charge controllers on their own.
            </p>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <span class="t-value block text-2xl">{BUSINESS.foundedYear}</span>
            <span class="t-small text-rule">Founded</span>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <div class="flex items-center gap-2">
              <Image src={googleLogo} alt="Google" width={20} height={20} class="h-5 w-5 shrink-0" />
              <RatingBadge class="inline-flex" compact />
            </div>
            <div class="mt-2 flex items-center gap-2">
              <Image src={justdialLogo} alt="Justdial" width={72} height={18} class="h-4 w-auto shrink-0" />
              <span class="t-value">{BUSINESS.justdial.rating.toFixed(1)}</span>
              <span class="rating-count t-small">({BUSINESS.justdial.reviewCount})</span>
            </div>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <a href="/commercial-solar-punjab/" class="no-underline">
              <span class="t-value block text-2xl">{BUSINESS.installs.commercial}</span>
              <span class="t-small text-rule underline">Commercial &amp; industrial installs</span>
            </a>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <a href="/solar-calculator/" class="no-underline">
              <span class="t-value block text-2xl">{BUSINESS.installs.residential}</span>
              <span class="t-small text-rule underline">Residential installs</span>
            </a>
          </div>
          <div class="col-span-4 px-6 py-5 lg:px-10">
            <a href="/solar-pumps/" class="no-underline">
              <span class="t-value block text-2xl">{BUSINESS.installs.solarPumps}</span>
              <span class="t-small text-rule underline">Solar pump &amp; tubewell installations for farmers</span>
            </a>
          </div>
          {
            reviews[0] && (
              <div class="col-span-4 px-6 py-6 lg:px-10">
                <blockquote>
                  <p class="text-rule">&ldquo;{reviews[0].text}&rdquo;</p>
                </blockquote>
                <p class="t-small mt-3 text-rule">
                  {reviews[0].name}, Google review{reviews[0].install && `, ${reviews[0].install}`}
                </p>
              </div>
            )
          }
          <div class="col-span-4 px-6 py-6 text-rule lg:px-10">
            <p class="t-small">Installation figures as of {BUSINESS.installs.asOf}.</p>
            <p class="mt-4"><a href="/about/" class="underline">More about RSK</a></p>
            <p class="mt-2"><a href="/products/" class="underline">What we supply</a></p>
            <p class="mt-2"><a href="/reviews/" class="underline">Read every review</a></p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- What we do: distributor and installer, said plainly, before any subsidy mechanics. -->
  <section class="sec-tight bg-white" aria-labelledby="what-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="what-h" class="t-h2">What we do</h2>
        <p class="mt-4 text-slate">
          RSK Solar Energy is a {BUSINESS.brand} distributor and installer. We design, supply and install rooftop solar for homes, businesses and housing societies, and handle the PM Surya Ghar paperwork where it applies.
        </p>
        <figure class="mt-8">
          <Image src={officePhoto} alt="RSK Solar Energy office at E-203, Phase 8B Industrial Area, Mohali, with the UTL Solar distributor sign" widths={[480, 800, 1200]} sizes="(min-width: 64rem) 33vw, 100vw" class="h-auto w-full border border-rule" />
          <figcaption class="t-small mt-2 text-slate">Our office and warehouse, E-203 Phase 8B, opposite Nexa Tower.</figcaption>
        </figure>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
      <ul class="ruled">
        {
          [
            { href: '/solar-calculator/', name: 'Rooftop solar for homes', blurb: 'On-grid systems sized to your bill, with the PM Surya Ghar subsidy applied for you.' },
            { href: '/commercial-solar-punjab/', name: 'Commercial & industrial solar', blurb: 'Shops, offices, clinics, schools and factories, sized to your sanctioned load.' },
            { href: '/housing-society-solar/', name: 'Housing societies & RWAs', blurb: `Common-area systems, with ₹${digits(cfg.subsidy.society.perKw)} per kW subsidy up to ${cfg.subsidy.society.maxKw} kW.` },
            { href: '/on-grid-vs-off-grid-vs-hybrid/', name: 'Hybrid & off-grid systems', blurb: 'Battery backup for power cuts, and systems for sites with no reliable grid.' },
            { href: '/solar-pumps/', name: 'Solar water pumps', blurb: `Tubewells and irrigation for farmers, ${BUSINESS.installs.solarPumps} installed.` },
          ].map((s) => (
            <li>
              <a href={s.href} class="grid grid-cols-[1fr_auto] gap-x-6 no-underline">
                <span>
                  <span class="t-h3 block underline decoration-rule">{s.name}</span>
                  <span class="mt-1 block text-slate">{s.blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <RooftopSolarArt class="mt-10 max-w-md" />
      </div>
    </div>
  </section>

  <!-- Real photos of RSK's own store rooms and office: proof of a physical, stocked business. -->
  <section class="sec-tight" aria-labelledby="warehouse-h">
    <div class="wrap">
      <div class="grid-12 lg:items-end">
        <h2 id="warehouse-h" class="t-h2 lg:col-span-6">At our Mohali office and warehouse</h2>
        <p class="text-slate lg:col-span-5 lg:col-start-8">UTL panels, batteries, PCUs and inverters in our Phase 8B store rooms. Visit during opening hours to see the products before you decide. <a href="/about/" class="underline">More photos</a></p>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <figure>
          <Image src={panelsAndBatteries} alt="Solar panels, UTL lithium batteries and solar PCUs in the RSK Solar Energy store room" widths={[400, 800, 1200]} sizes="(min-width: 40rem) 30vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">Panels, batteries and PCUs in the store room.</figcaption>
        </figure>
        <figure>
          <Image src={pcusAndInverters} alt="Boxed UTL Gamma+ and Heliac solar PCUs and Taqnia inverters in stock at RSK Solar Energy" widths={[400, 800, 1200]} sizes="(min-width: 40rem) 30vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">UTL Gamma+ and Heliac PCUs and inverters.</figcaption>
        </figure>
        <figure>
          <Image src={meetingCabin} alt="Meeting cabin at the RSK Solar Energy office in Phase 8B, Mohali" widths={[400, 800, 1200]} sizes="(min-width: 40rem) 30vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">The meeting cabin at E-203.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Catalogue: real product photography, so the page shows what RSK actually supplies. -->
  <section class="sec" aria-labelledby="products-h">
    <div class="wrap">
      <div class="grid-12 lg:items-end">
        <div class="lg:col-span-6">
          <h2 id="products-h" class="t-h2">UTL Solar panels, inverters and batteries</h2>
          <p class="mt-4 text-slate">
            RSK is a {BUSINESS.brand} distributor. Every product page carries the manufacturer's full specification. We don't sell online: ask on WhatsApp for today's price and stock.
          </p>
        </div>
        <p class="t-small text-slate lg:col-span-5 lg:col-start-8">
          Run a shop or install solar yourself? <a href="/solar-dealership-punjab/" class="underline">Become a UTL dealer</a> and buy at wholesale pricing.
        </p>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
        {
          featured.map(({ c, product, image, count }) => (
            <li>
              <a href={`/products/${c.id}/`} class="group flex h-full flex-col border border-rule bg-white no-underline hover:border-ink">
                <span class="block aspect-square p-5">
                  {product && image && <Image src={image} alt={product.title} width={360} height={360} loading="lazy" class="h-full w-full object-contain" />}
                </span>
                <span class="mt-auto block border-t border-rule px-4 py-3">
                  <span class="block font-semibold group-hover:underline">{c.name}</span>
                  <span class="t-small block text-slate">{count} products</span>
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="/products/" class="on-ink flex h-full min-h-48 flex-col justify-between bg-ink p-5 text-white no-underline hover:bg-slate">
            <span class="t-readout">{PRODUCTS.length}</span>
            <span>
              <span class="block font-semibold">Browse every UTL product</span>
              <span class="t-small block text-rule">With full specifications</span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- The Punjab constraint, said plainly. -->
  <section class="sec-open border-t border-rule" aria-labelledby="line-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-5">
        <h2 id="line-h" class="t-h1">In Punjab, the {threshold}-unit line decides whether solar pays.</h2>
        <p class="mt-6">
          Homes get {threshold} free units a month ({cfg.freeUnits.perBillingCycle} on a two-month bill). Under the line, the bill is zero and solar has nothing to save. Over it, a general-category home pays for <strong>every</strong> unit, not just the extra ones.
        </p>
        <p class="mt-4">
          That cliff is why the right size matters more than a big roof. A home using 320 units a month pays about <span class="t-value">{inr(bill320, 10)}</span> a month. Bring its net use under {threshold} and the bill is <span class="t-value">₹0</span>.
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <table class="spec-table">
          <caption class="sr-only">What solar does for each kind of connection</caption>
          <thead>
            <tr><th scope="col">Your connection</th><th scope="col">What solar does for you</th></tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="font-semibold">Home under {threshold} units a month</th>
              <td>Nothing for your bill; it is already zero. Consider it only for backup during power cuts, or if your use is about to rise.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Home over {threshold}, up to about 600 units</th>
              <td>Our smallest on-grid system, {minOnGridKw} kW, clears the whole bill. It pays back fastest nearer 600 units, since the same system avoids a bigger bill.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Home well over 600 units</th>
              <td>A home at 700 units pays about <span class="t-value">{inr(bill700, 10)}</span> a month. Bigger homes step up to 4, 5, 6 kW and beyond, sized the same way.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Shop, office, factory</th>
              <td>No free units and no subsidy, so solar saves from the first unit. Payback depends on daytime use.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Housing society</th>
              <td>₹{digits(cfg.subsidy.society.perKw)} per kW subsidy for common areas and EV charging, up to {cfg.subsidy.society.maxKw} kW.</td>
            </tr>
          </tbody>
        </table>
        <p class="t-small mt-4 text-slate">Bills worked out from the PSPCL {cfg.pspcl.tariffYear} domestic tariff for a 5 kW sanctioned load, including fixed charges and {cfg.pspcl.electricityDutyPercent}% electricity duty.</p>
      </div>
    </div>
  </section>

  <!-- Sizes: data table, tight rhythm. -->
  <section class="sec-tight bg-white" aria-labelledby="sizes-h">
    <div class="wrap">
      <div class="grid-12 items-end">
        <h2 id="sizes-h" class="t-h2 lg:col-span-6">System sizes, what they make and what they cost</h2>
        <p class="text-slate lg:col-span-5 lg:col-start-8">
          The last column is the monthly home use each size takes to a zero bill, under Punjab's free-units rule.
        </p>
      </div>
      <div class="mt-8"><SizeTable /></div>
    </div>
  </section>

  <!-- Subsidy: the one fact that prevents the most common surprise, not the full process. -->
  <section class="sec-tight" aria-labelledby="subsidy-strip-h">
    <div class="wrap grid-12 items-start">
      <div class="lg:col-span-5">
        <h2 id="subsidy-strip-h" class="t-h2">You pay first. The subsidy comes after.</h2>
        <p class="mt-4">
          PM Surya Ghar pays up to <span class="t-value">{inr(cfg.subsidy.residential.cap)}</span> towards a home system, credited to your bank account {d0}–{d1} days after PSPCL inspects it. It is never deducted from the price, and homes are only one part of it: housing societies and businesses have their own numbers too.
        </p>
      </div>
      <div class="mt-6 lg:col-span-6 lg:col-start-7 lg:mt-0">
        <a href="/pm-surya-ghar-subsidy-punjab/" class="btn btn-secondary">Read the full subsidy guide</a>
      </div>
    </div>
  </section>

  <!-- Real reviews, on ink. -->
  <section class="on-ink sec-open bg-ink text-white" aria-labelledby="reviews-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="reviews-h" class="t-h2">What customers say</h2>
        <div class="mt-8 flex items-center gap-3">
          <Image src={googleLogo} alt="Google" width={28} height={28} class="h-7 w-7 shrink-0" />
          <p class="flex items-baseline gap-3">
            <span class="t-readout text-signal">{BUSINESS.google.rating.toFixed(1)}</span>
            <span class="text-rule">out of 5 from {BUSINESS.google.reviewCount} Google reviews</span>
          </p>
        </div>
        <div class="mt-4 flex items-center gap-3">
          <Image src={justdialLogo} alt="Justdial" width={220} height={57} class="h-5 w-auto shrink-0" />
          <p class="text-rule">{BUSINESS.justdial.rating.toFixed(1)} from {BUSINESS.justdial.reviewCount} reviews</p>
        </div>
        <p class="mt-6 flex flex-col gap-2">
          <a href="/reviews/" class="underline">Read every review</a>
          <a href={BUSINESS.google.mapsUrl} class="underline" rel="noopener" target="_blank">Open our Google listing</a>
          {BUSINESS.justdial.url && <a href={BUSINESS.justdial.url} class="underline" rel="noopener" target="_blank">Open our Justdial listing</a>}
        </p>
      </div>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        {
          reviews.map((r) => (
            <li class="py-6">
              <blockquote>
                <p class="t-lead">{r.text}</p>
              </blockquote>
              <p class="t-small mt-3 text-rule">
                {r.name}, Google review, {reviewMonth(r.date)}
                {r.install && <span class="block">Installed: {r.install}</span>}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Where we install: direct service area, then dealer-network reach. Links every city page. -->
  <section class="sec-tight bg-white" aria-labelledby="areas-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="areas-h" class="t-h2">Where we install</h2>
        <p class="mt-4 text-slate">Our own team covers Tricity, Kurali, Morinda, Ropar and the towns around them from the Phase 8B office. Across the rest of Punjab we work through the UTL dealers we supply.</p>
        <p class="mt-4"><a href="/contact/" class="underline">Contact and directions</a></p>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        <div>
          <h3 class="t-small font-semibold text-slate">Our own installation team</h3>
          <ul class="mt-3 grid grid-cols-2 gap-x-4">
            {
              directCities.map((c) => (
                <li class="py-1.5">
                  <a href={cityPath(c.slug)} class="underline">
                    {c.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="t-small font-semibold text-slate">Through our Punjab dealer network</h3>
          <ul class="mt-3 grid grid-cols-2 gap-x-4">
            {
              partnerCities.map((c) => (
                <li class="py-1.5">
                  <a href={cityPath(c.slug)} class="underline">
                    {c.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Brands and dealer network: the UTL association, and a real named dealer partner. -->
  <section class="sec-tight border-t border-rule bg-white" aria-labelledby="brands-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="brands-h" class="t-h2">Brands and dealer network</h2>
        <p class="mt-4 text-slate">Who we distribute for, and who we work with across Punjab.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        <div class="border border-rule p-6">
          <p class="t-small text-slate">Authorised distributor of</p>
          <Image src={utlLogo} alt="UTL Solar" width={200} class="mt-3 h-auto w-40" />
          <p class="mt-4 text-slate">
            RSK Solar Energy distributes and installs {BUSINESS.brand} panels, inverters, batteries and complete systems. RSK is an independent distributor, not a UTL-owned outlet.
          </p>
          <p class="mt-4"><a href="/utl-solar-distributor-punjab/" class="underline">About our UTL distributorship</a></p>
        </div>
        <div class="border border-rule p-6">
          <p class="t-small text-slate">Dealer network partner</p>
          <Image src={kangLogo} alt="Kang Electricals" width={220} class="mt-3 h-auto w-44" />
          <p class="mt-3 text-slate">
            Based in Morinda, Punjab, Kang Electricals stocks solar products, electric bikes and home appliances, including UTL. It is an important part of RSK's dealer network in the Rupnagar area.
          </p>
          <p class="mt-4">
            <a href="https://kangelectricals.in/" rel="noopener" target="_blank" class="underline">Visit kangelectricals.in</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Also stocked: a teaser of other brands, full list on its own page. -->
  <section class="sec-tight border-t border-rule bg-white" aria-labelledby="also-stock-h">
    <div class="wrap grid-12 items-center">
      <div class="lg:col-span-4">
        <h2 id="also-stock-h" class="t-h2">Also stocked at RSK</h2>
        <p class="mt-4 text-slate">Fans, coolers, appliances and tubewell motors, alongside our solar equipment.</p>
        <p class="mt-4"><a href="/brands-and-partners/" class="underline">See every brand we stock</a></p>
      </div>
      <ul class="mt-8 grid grid-cols-3 gap-4 sm:grid-cols-6 lg:col-span-7 lg:col-start-6 lg:mt-0">
        {
          brandTeaser.map((b) => (
            <li class="flex h-16 items-center justify-center border border-rule bg-white p-3">
              {b.logo ? <Image src={b.logo} alt={b.name} width={160} class="h-auto max-h-8 w-auto max-w-full object-contain" /> : <span class="t-small text-center">{b.name}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Follow: social links (only real, confirmed profiles) and videos, if any are added. -->
  <section class="sec-tight border-t border-rule" aria-labelledby="follow-h">
    <div class="wrap grid-12 items-center">
      <div class="lg:col-span-4">
        <h2 id="follow-h" class="t-h2">Follow RSK</h2>
        <p class="mt-4 text-slate">Installation photos and updates from Phase 8B, Mohali.</p>
        <SocialLinks class="mt-5" />
      </div>
      {
        VIDEOS.length > 0 && (
          <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:col-span-7 lg:col-start-6 lg:mt-0">
            {VIDEOS.map((v) => {
              const thumb = v.platform === 'youtube' ? youtubeThumbnail(v.url) : null;
              return (
                <li>
                  <a href={v.url} rel="noopener" target="_blank" class="relative block aspect-video overflow-hidden border border-rule bg-ink no-underline">
                    {thumb && <img src={thumb} alt="" loading="lazy" class="h-full w-full object-cover" />}
                    <span class="absolute inset-0 flex items-center justify-center text-white">
                      <Icon name="play" size={32} />
                    </span>
                  </a>
                  <p class="t-small mt-2">{v.title}</p>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Close with the action: two paths, remote estimate or an in-person visit. -->
  <section class="sec-tight border-t border-rule bg-white" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 id="cta-h" class="t-h2">Ready to talk?</h2>
      <div class="grid-12 mt-8 grid gap-8">
        <div class="lg:col-span-6">
          <p class="t-h3">Send us your last electricity bill</p>
          <p class="mt-2 text-slate">A photo is enough. We reply with the right size, the cost after subsidy and what your connection needs first.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <WhatsAppButton label="Send my bill on WhatsApp" message={billMessage()} variant="secondary" />
            <a class="btn btn-secondary" href={`tel:${PRIMARY_PHONE.tel}`}>Call {PRIMARY_PHONE.display}</a>
          </div>
        </div>
        <div class="lg:col-span-6 lg:border-l lg:border-rule lg:pl-8">
          <p class="t-h3">Book a free site inspection</p>
          <p class="mt-2 text-slate">Prefer someone to look at your roof and connection in person? We visit, measure and quote on the spot, at no charge.</p>
          <div class="mt-5">
            <WhatsAppButton label="Book a free site inspection" message={siteInspectionMessage()} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
