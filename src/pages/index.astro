---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import RatingBadge from '../components/RatingBadge.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SizeTable from '../components/content/SizeTable.astro';
import { BUSINESS, PRIMARY_PHONE } from '../config/business';
import { SOLAR_CONFIG } from '../config/solar-config';
import { monthlyBill } from '../lib/calculator/tariff';
import { digits, inr } from '../lib/calculator/format';
import { REVIEWS, reviewMonth } from '../data/reviews';
import { CATEGORIES, productsIn } from '../data/products';
import { billMessage } from '../lib/whatsapp';
import { website } from '../lib/seo';

const cfg = SOLAR_CONFIG;
const threshold = cfg.freeUnits.perMonth;
const billAt = (u: number) => monthlyBill(u, { category: 'domestic', scheme: 'general', loadKw: 5, config: cfg }).total;
const bill320 = billAt(320);
const bill700 = billAt(700);
const minOnGridKw = cfg.sizing.minKwByType['on-grid'];
const [d0, d1] = cfg.subsidy.disbursementDays;
const reviews = REVIEWS.slice(0, 4);

const title = 'Rooftop Solar in Mohali and Punjab, Priced After Subsidy | RSK Solar Energy';
const description = `UTL Solar distributor in Phase 8-B, Mohali. Enter your PSPCL bill and see the system size, PM Surya Ghar subsidy (up to ₹78,000) and your cost after subsidy.`;
---

<BaseLayout title={title} description={description} schema={[website()]}>
  <!-- Hero: the calculator is the hero (DESIGN.md §6). -->
  <section class="wrap">
    <div class="grid-12 lg:items-stretch">
      <div class="pt-10 pb-12 lg:col-span-7 lg:pt-16 lg:pb-20 lg:pr-6">
        <h1 class="t-display max-w-[13ch]">What will solar cost you after the subsidy?</h1>
        <p class="t-lead mt-6 max-w-xl">
          Enter your PSPCL bill. We size the system, take off the PM Surya Ghar subsidy and show your payback, for homes and businesses in Mohali, Tricity and Punjab. If solar will not pay back for you, the calculator says so.
        </p>
        <div class="mt-8">
          <Calculator variant="hero" id="hero-calc" />
        </div>
        <div class="mt-10 border-t border-rule pt-4 settle">
          <ul class="t-small flex flex-wrap gap-x-6 gap-y-2 text-slate">
            <li>{BUSINESS.brand} distributor, Phase 8-B Mohali</li>
            <li><RatingBadge class="inline-flex" /></li>
            <li>Since {BUSINESS.foundedYear}</li>
          </ul>
        </div>
      </div>

      <aside class="on-ink bleed-x bleed-right-lg bg-ink text-white lg:col-span-5" aria-labelledby="identity-panel-h">
        <div class="cell-grid h-full lg:grid-rows-[repeat(5,auto)_1fr]">
          <div class="col-span-4 px-6 pt-10 pb-8 lg:px-10 lg:pt-16">
            <p class="t-small text-rule">{BUSINESS.brand} distributor</p>
            <h2 id="identity-panel-h" class="t-h2 mt-2">RSK Solar Energy</h2>
            <p class="mt-3 text-rule">
              We supply and install {BUSINESS.brand} rooftop solar from Phase 8-B, Mohali: on-grid, hybrid and off-grid systems, plus panels, inverters, batteries and charge controllers on their own.
            </p>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <span class="t-value block text-2xl">{BUSINESS.foundedYear}</span>
            <span class="t-small text-rule">Founded</span>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <span class="t-value block text-2xl">{BUSINESS.installs.commercial}</span>
            <span class="t-small text-rule">Commercial &amp; industrial installs</span>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <span class="t-value block text-2xl">{BUSINESS.installs.residential}</span>
            <span class="t-small text-rule">Residential installs</span>
          </div>
          <div class="col-span-2 px-6 py-5 lg:px-10">
            <RatingBadge class="inline-flex" />
            <span class="t-small mt-1 block text-rule">on Google</span>
          </div>
          <div class="col-span-4 px-6 py-6 text-rule lg:px-10">
            <p class="t-small">Installation figures as of {BUSINESS.installs.asOf}.</p>
            <p class="mt-4"><a href="/about/" class="underline">More about RSK</a></p>
            <p class="mt-2"><a href="/products/" class="underline">What we supply</a></p>
          </div>
          {/* Empty cells continue the panel grid to the bottom of the hero on desktop. */}
          {[1, 2, 3, 4].map(() => <div class="hidden lg:block lg:min-h-24" />)}
        </div>
      </aside>
    </div>
  </section>

  <!-- What we do: distributor and installer, said plainly, before any subsidy mechanics. -->
  <section class="sec-tight bg-white" aria-labelledby="what-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="what-h" class="t-h2">What we do</h2>
        <p class="mt-4 text-slate">
          RSK Solar Energy is a {BUSINESS.brand} distributor and installer. We design, supply and install rooftop solar for homes, businesses and housing societies, and handle the PM Surya Ghar paperwork where it applies.
        </p>
      </div>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        {
          [
            { href: '/solar-calculator/', name: 'Rooftop solar for homes', blurb: 'On-grid systems sized to your bill, with the PM Surya Ghar subsidy applied for you.' },
            { href: '/commercial-solar-punjab/', name: 'Commercial & industrial solar', blurb: 'Shops, offices, clinics, schools and factories, sized to your sanctioned load.' },
            { href: '/housing-society-solar/', name: 'Housing societies & RWAs', blurb: `Common-area systems, with ₹${digits(cfg.subsidy.society.perKw)} per kW subsidy up to ${cfg.subsidy.society.maxKw} kW.` },
            { href: '/on-grid-vs-off-grid-vs-hybrid/', name: 'Hybrid & off-grid systems', blurb: 'Battery backup for power cuts, and systems for sites with no reliable grid.' },
            { href: '/products/', name: `${BUSINESS.brand} product supply`, blurb: 'Panels, inverters, batteries and charge controllers, with full specifications.' },
          ].map((s) => (
            <li>
              <a href={s.href} class="grid grid-cols-[1fr_auto] gap-x-6 no-underline">
                <span>
                  <span class="t-h3 block underline decoration-rule">{s.name}</span>
                  <span class="mt-1 block text-slate">{s.blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The Punjab constraint, said plainly. -->
  <section class="sec-open" aria-labelledby="line-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-5">
        <h2 id="line-h" class="t-h1">In Punjab, the {threshold}-unit line decides whether solar pays.</h2>
        <p class="mt-6">
          Homes get {threshold} free units a month ({cfg.freeUnits.perBillingCycle} on a two-month bill). Under the line, the bill is zero and solar has nothing to save. Over it, a general-category home pays for <strong>every</strong> unit, not just the extra ones.
        </p>
        <p class="mt-4">
          That cliff is why the right size matters more than a big roof. A home using 320 units a month pays about <span class="t-value">{inr(bill320, 10)}</span> a month. Bring its net use under {threshold} and the bill is <span class="t-value">₹0</span>.
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <table class="spec-table">
          <caption class="sr-only">What solar does for each kind of connection</caption>
          <thead>
            <tr><th scope="col">Your connection</th><th scope="col">What solar does for you</th></tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="font-semibold">Home under {threshold} units a month</th>
              <td>Nothing for your bill; it is already zero. Consider it only for backup during power cuts, or if your use is about to rise.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Home over {threshold}, up to about 600 units</th>
              <td>Our smallest on-grid system, {minOnGridKw} kW, clears the whole bill. It pays back fastest nearer 600 units, since the same system avoids a bigger bill.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Home well over 600 units</th>
              <td>A home at 700 units pays about <span class="t-value">{inr(bill700, 10)}</span> a month. Bigger homes step up to 4, 5, 6 kW and beyond, sized the same way.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Shop, office, factory</th>
              <td>No free units and no subsidy, so solar saves from the first unit. Payback depends on daytime use.</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold">Housing society</th>
              <td>₹{digits(cfg.subsidy.society.perKw)} per kW subsidy for common areas and EV charging, up to {cfg.subsidy.society.maxKw} kW.</td>
            </tr>
          </tbody>
        </table>
        <p class="t-small mt-4 text-slate">Bills worked out from the PSPCL {cfg.pspcl.tariffYear} domestic tariff for a 5 kW sanctioned load, including fixed charges and {cfg.pspcl.electricityDutyPercent}% electricity duty.</p>
      </div>
    </div>
  </section>

  <!-- Sizes: data table, tight rhythm. -->
  <section class="sec-tight bg-white" aria-labelledby="sizes-h">
    <div class="wrap">
      <div class="grid-12 items-end">
        <h2 id="sizes-h" class="t-h2 lg:col-span-6">System sizes, what they make and what they cost</h2>
        <p class="text-slate lg:col-span-5 lg:col-start-8">
          The last column is the monthly home use each size takes to a zero bill, under Punjab's free-units rule.
        </p>
      </div>
      <div class="mt-8"><SizeTable /></div>
    </div>
  </section>

  <!-- Subsidy: the one fact that prevents the most common surprise, not the full process. -->
  <section class="sec-tight" aria-labelledby="subsidy-strip-h">
    <div class="wrap grid-12 items-start">
      <div class="lg:col-span-5">
        <h2 id="subsidy-strip-h" class="t-h2">You pay first. The subsidy comes after.</h2>
        <p class="mt-4">
          PM Surya Ghar pays up to <span class="t-value">{inr(cfg.subsidy.residential.cap)}</span> towards a home system, credited to your bank account {d0}–{d1} days after PSPCL inspects it. It is never deducted from the price, and homes are only one part of it: housing societies and businesses have their own numbers too.
        </p>
      </div>
      <div class="mt-6 lg:col-span-6 lg:col-start-7 lg:mt-0">
        <a href="/pm-surya-ghar-subsidy-punjab/" class="btn btn-secondary">Read the full subsidy guide</a>
      </div>
    </div>
  </section>

  <!-- Real reviews, on ink. -->
  <section class="on-ink sec-open bg-ink text-white" aria-labelledby="reviews-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="reviews-h" class="t-h2">What customers say</h2>
        <p class="mt-8 flex items-baseline gap-3">
          <span class="t-readout text-signal">{BUSINESS.google.rating.toFixed(1)}</span>
          <span class="text-rule">out of 5 from {BUSINESS.google.reviewCount} Google reviews</span>
        </p>
        <p class="mt-2 text-rule">Also {BUSINESS.justdial.rating.toFixed(1)} from {BUSINESS.justdial.reviewCount} reviews on Justdial.</p>
        <p class="mt-6 flex flex-col gap-2">
          <a href="/reviews/" class="underline">Read every review</a>
          <a href={BUSINESS.google.mapsUrl} class="underline" rel="noopener" target="_blank">Open our Google listing</a>
        </p>
      </div>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        {
          reviews.map((r) => (
            <li class="py-6">
              <blockquote>
                <p class="t-lead">{r.text}</p>
              </blockquote>
              <p class="t-small mt-3 text-rule">
                {r.name}, Google review, {reviewMonth(r.date)}
                {r.install && <span class="block">Installed: {r.install}</span>}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Catalogue -->
  <section class="sec" aria-labelledby="products-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="products-h" class="t-h2">UTL Solar products we supply</h2>
        <p class="mt-4">
          RSK is a {BUSINESS.brand} distributor. Panels, inverters, batteries and complete kits, with full specifications on every product page.
        </p>
        <p class="mt-6"><a href="/products/" class="btn btn-secondary">Browse all products</a></p>
        <p class="t-small mt-4 text-slate">
          Run a shop or install solar yourself? <a href="/solar-dealership-punjab/" class="underline">Become a UTL dealer</a> and buy at wholesale pricing.
        </p>
      </div>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        {
          CATEGORIES.map((c) => (
            <li>
              <a href={`/products/#${c.id}`} class="grid grid-cols-[1fr_auto] gap-x-6 no-underline">
                <span>
                  <span class="t-h3 block underline decoration-rule">{c.name}</span>
                  <span class="mt-1 block text-slate">{c.blurb}</span>
                </span>
                <span class="t-value text-slate">{productsIn(c.id).length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Close with the action. -->
  <section class="sec-tight border-t border-rule bg-white" aria-labelledby="cta-h">
    <div class="wrap grid-12 items-center">
      <div class="lg:col-span-7">
        <h2 id="cta-h" class="t-h2">Send us your last electricity bill on WhatsApp</h2>
        <p class="mt-3 text-slate">A photo is enough. We reply with the right size, the cost after subsidy and what your connection needs first.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
        <WhatsAppButton label="Send my bill on WhatsApp" message={billMessage()} variant="secondary" />
        <a class="btn btn-secondary" href={`tel:${PRIMARY_PHONE.tel}`}>Call {PRIMARY_PHONE.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>
