---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import DraftNote from '../components/DraftNote.astro';
import CtaBlock from '../components/content/CtaBlock.astro';
import SizeTable from '../components/content/SizeTable.astro';
import { SOLAR_CONFIG } from '../config/solar-config';
import { SIZE_COPY, sizeFacts, sizePath } from '../data/sizes';
import { calculate } from '../lib/calculator/calculate';
import { digits, inr, inrRange, yearsRange } from '../lib/calculator/format';
import { sizeMessage } from '../lib/whatsapp';
import { faqPage, service, type QA } from '../lib/seo';

export function getStaticPaths() {
  return SOLAR_CONFIG.sizing.sizePagesKw.map((kw) => ({ params: { kw: String(kw) }, props: { kw } }));
}

const TYPE_LABEL = { 'on-grid': 'On-grid', hybrid: 'Hybrid', 'off-grid': 'Off-grid' } as const;

const { kw } = Astro.props;
const s = sizeFacts(kw);
const copy = SIZE_COPY[kw]!;
const cfg = SOLAR_CONFIG;
const path = sizePath(kw);
const capped = kw >= cfg.subsidy.residential.secondBandUpToKw;
const primaryLabel = TYPE_LABEL[s.primaryType];

// Worked example: a general-category home at the top of this size's zero-bill range, on the
// type this page actually offers at this size.
const exampleUnits = s.zeroBillRange[1];
const example = calculate({ consumption: { kind: 'units', value: exampleUnits, periodMonths: 1 }, category: 'domestic', systemType: s.primaryType, sanctionedLoadKw: 5 });

const title = `${kw} kW Solar System Price in Punjab 2026, After Subsidy`;
const description = `${kw} kW ${primaryLabel.toLowerCase()} solar in Punjab: ${inrRange(s.primaryGross)} installed, ${inrRange(s.primaryNet)} after the ${inr(s.subsidy)} PM Surya Ghar subsidy. About ${digits(s.monthlyUnits)} units a month.`;

const faq: QA[] = [
  {
    q: `What is the price of a ${kw} kW solar system in Punjab?`,
    a: `A ${primaryLabel.toLowerCase()} ${kw} kW system costs ${inrRange(s.primaryGross)} installed. After the PM Surya Ghar subsidy of ${inr(s.subsidy)}, a home pays ${inrRange(s.primaryNet)}.${
      s.offersOnGrid
        ? ` A hybrid system with a battery costs ${inrRange(s.prices.hybrid)} and is subsidised the same way; an off-grid system costs ${inrRange(s.prices.offGrid)} and does not qualify for the subsidy.`
        : ` RSK Solar Energy does not install on-grid systems this small; 3 kW is the smallest on-grid system we offer. An off-grid system at ${kw} kW costs ${inrRange(s.prices.offGrid)}, but does not qualify for the subsidy.`
    } The final price depends on the roof, the mounting structure, cable runs and the panel model.`,
  },
  {
    q: `How much subsidy do I get on a ${kw} kW system?`,
    a: `${inr(s.subsidy)} for a home, whether the system is on-grid or hybrid. RSK Solar Energy's hybrid systems are grid-tied and net-metered, so they qualify the same way on-grid does.${capped ? ` The subsidy is capped at ${inr(cfg.subsidy.residential.cap)} from 3 kW upwards.` : ''} It is paid into your bank account ${cfg.subsidy.disbursementDays[0]} to ${cfg.subsidy.disbursementDays[1]} days after PSPCL inspects the system, not deducted from the price. Off-grid systems, businesses and industry do not get it; housing societies get ₹${digits(cfg.subsidy.society.perKw)} per kW for common facilities.`,
  },
  {
    q: `How many units does a ${kw} kW solar system generate in Punjab?`,
    a: `About ${digits(s.monthlyUnits)} units a month, or ${digits(s.annualUnits)} a year, at the conservative figure we use for estimates. Output is higher from March to June and lower in December and January and on hazy days.`,
  },
  {
    q: `How much roof space does a ${kw} kW system need?`,
    a: `About ${digits(s.roofSqFt)} sq ft of shade-free roof, at roughly ${cfg.generation.sqFtPerKw} sq ft per kW including access space between rows.`,
  },
  {
    q: `What sanctioned load do I need for a ${kw} kW system?`,
    a: `At least ${kw} kW. In Punjab a rooftop system cannot exceed your sanctioned load, which is printed on your electricity bill. If yours is lower, apply to PSPCL for load enhancement before applying for the subsidy.`,
  },
  {
    q: `Is ${kw} kW the right size for my home?`,
    a: `For a general-category home, a ${kw} kW system brings net use under the ${cfg.freeUnits.perMonth}-unit line for homes using roughly ${digits(s.zeroBillRange[0])} to ${digits(s.zeroBillRange[1])} units a month, which takes the bill to zero. Enter your own bill in the calculator on our website to check.`,
  },
];

const schema = [
  service({ name: `${kw} kW rooftop solar system`, description, path, serviceType: 'Rooftop solar system installation' }),
  faqPage(faq),
];
---

<BaseLayout title={title} description={description} crumbs={[{ name: `${kw} kW solar system price`, path }]} schema={schema}>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: `${kw} kW solar system price`, path }]} />
    <h1 class="t-h1 mt-6">{kw} kW solar system price in Punjab</h1>
    <p class="t-lead measure mt-5">
      {copy.suits} About {digits(s.monthlyUnits)} units a month from {digits(s.roofSqFt)} sq ft of roof.
    </p>
  </header>

  <section class="wrap grid-12 pb-16" aria-label={`${kw} kW system facts`}>
    <div class="lg:col-span-7">
      <table class="spec-table">
        <caption class="sr-only">{kw} kW {primaryLabel.toLowerCase()} system: price, subsidy and generation</caption>
        <tbody>
          <tr><th scope="row">{primaryLabel} system, installed</th><td class="num">{inrRange(s.primaryGross)}</td></tr>
          <tr><th scope="row">PM Surya Ghar subsidy, home</th><td class="num">− {inr(s.subsidy)}</td></tr>
        </tbody>
        <tbody class="calc-net">
          <tr>
            <th scope="row">Your cost after subsidy</th>
            <td class="num"><span class="t-readout">{inrRange(s.primaryNet)}</span></td>
          </tr>
        </tbody>
        <tbody>
          <tr><th scope="row">Generation</th><td class="num">{digits(s.monthlyUnits)} units a month</td></tr>
          <tr><th scope="row">Roof area</th><td class="num">{digits(s.roofSqFt)} sq ft</td></tr>
          <tr><th scope="row">Minimum sanctioned load</th><td class="num">{kw} kW</td></tr>
          <tr>
            <th scope="row">Takes a home to a zero bill if it uses</th>
            <td class="num">{digits(s.zeroBillRange[0])} – {digits(s.zeroBillRange[1])} units a month</td>
          </tr>
        </tbody>
      </table>
      <p class="calc-fineprint mt-4">
        <strong>You pay the full price first.</strong> The subsidy is credited to your bank account {cfg.subsidy.disbursementDays[0]}–{cfg.subsidy.disbursementDays[1]} days after the PSPCL inspection.
      </p>
      <div class="mt-4"><DraftNote /></div>
      {s.primaryGrossConfirmed && (
        <p class="t-small mt-4 text-slate">The range for this size starts at our own quoted price.</p>
      )}
    </div>
    <aside class="lg:col-span-4 lg:col-start-9">
      <CtaBlock heading={`Ask about a ${kw} kW system`} label={`Ask about a ${kw} kW system on WhatsApp`} message={sizeMessage(kw, s.primaryType)} body="Send your electricity bill too, and we confirm whether this is the right size before quoting." />
    </aside>
  </section>

  <section class="sec bg-white" aria-labelledby="suits-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="suits-h" class="t-h2">Before you choose {kw} kW</h2>
      </div>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        {copy.notes.map((n) => <li>{n}</li>)}
        <li>
          Not sure? <a href={`/solar-calculator/?units=${exampleUnits}&period=1&category=domestic`} class="underline">Enter your bill in the calculator</a>. It recommends the smallest system that does the job.
        </li>
      </ul>
    </div>
  </section>

  <section class="sec-tight" aria-labelledby="types-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-7">
        <h2 id="types-h" class="t-h2">{kw} kW price by system type</h2>
        <div class="table-scroll mt-6">
          <table class="spec-table min-w-lg">
            <thead>
              <tr>
                <th scope="col">Type</th>
                <th scope="col" class="num">Installed</th>
                <th scope="col" class="num">Home subsidy</th>
                <th scope="col" class="num">After subsidy</th>
              </tr>
            </thead>
            <tbody>
              {s.offersOnGrid && s.prices.onGrid && (
                <tr><th scope="row">On-grid</th><td class="num">{inrRange(s.prices.onGrid)}</td><td class="num">{inr(s.subsidy)}</td><td class="num">{inrRange([s.prices.onGrid[0] - s.subsidy, s.prices.onGrid[1] - s.subsidy])}</td></tr>
              )}
              <tr>
                <th scope="row">Hybrid, with battery</th>
                <td class="num">{inrRange(s.prices.hybrid)}</td>
                <td class="num">{inr(s.subsidy)}</td>
                <td class="num">{inrRange([s.prices.hybrid[0] - s.subsidy, s.prices.hybrid[1] - s.subsidy])}</td>
              </tr>
              <tr><th scope="row">Off-grid</th><td class="num">{inrRange(s.prices.offGrid)}</td><td class="num">₹0</td><td class="num">{inrRange(s.prices.offGrid)}</td></tr>
            </tbody>
          </table>
        </div>
        <p class="t-small mt-3 text-slate">
          Includes panels, inverter, mounting structure, wiring and installation.{!s.offersOnGrid && ' On-grid is not offered at this size; 3 kW is our smallest on-grid system.'} <a href="/on-grid-vs-off-grid-vs-hybrid/" class="underline">How the three differ</a>
        </p>
      </div>

      {
        example.outcome === 'ok' && (
          <div class="lg:col-span-4 lg:col-start-9">
            <h2 class="t-h3">Worked example</h2>
            <p class="mt-2 text-slate">
              A general-category home using {digits(exampleUnits)} units a month, with a {kw} kW {primaryLabel.toLowerCase()} system.
            </p>
            <table class="spec-table mt-4">
              <tbody>
                <tr><th scope="row">Bill now</th><td class="num">{inr(example.billBefore.total, 10)}</td></tr>
                <tr><th scope="row">Bill after solar</th><td class="num">{inr(example.billAfter.total, 10)}</td></tr>
                <tr><th scope="row">Yearly saving</th><td class="num">{inr(example.annualSaving, 100)}</td></tr>
                <tr><th scope="row">Payback</th><td class="num">{example.paybackYears ? yearsRange(example.paybackYears) : '—'}</td></tr>
              </tbody>
            </table>
            <p class="t-small mt-3 text-slate">PSPCL {cfg.pspcl.tariffYear} tariff, 5 kW sanctioned load, {cfg.pspcl.electricityDutyPercent}% duty.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="sec border-t border-rule" aria-labelledby="sizes-h">
    <div class="wrap">
      <h2 id="sizes-h" class="t-h2 mb-8">Other sizes</h2>
      <SizeTable highlight={kw} />
    </div>
  </section>

  <section class="sec bg-white">
    <div class="wrap grid-12">
      <div class="lg:col-span-8"><Faq items={faq} heading={`${kw} kW system: questions we are asked`} /></div>
    </div>
  </section>
</BaseLayout>
