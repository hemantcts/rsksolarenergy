---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBlock from '../components/content/CtaBlock.astro';
import { BUSINESS, formatAddressLines } from '../config/business';
import { F } from '../lib/facts';
import SolarPumpArt from '../components/art/SolarPumpArt.astro';
import { Image } from 'astro:assets';
import officePhoto from '../assets/office/rsk-solar-energy-office-mohali.jpg';
import meetingCabin from '../assets/office/office-meeting-cabin.jpg';
import teamAtWork from '../assets/office/office-team-at-work.jpg';
import panelsAndBatteries from '../assets/office/warehouse-panels-and-batteries.jpg';
import pcusAndInverters from '../assets/office/warehouse-pcus-and-inverters.jpg';
import panelStack from '../assets/office/warehouse-panel-stack.jpg';

const facts: [string, string][] = [
  ['Founded', String(BUSINESS.foundedYear)],
  ['Based at', formatAddressLines().join(', ')],
  ['Distributor of', BUSINESS.brand],
  ['Commercial and industrial installations', `${BUSINESS.installs.commercial} (as of ${BUSINESS.installs.asOf})`],
  ['Residential installations', `${BUSINESS.installs.residential} (as of ${BUSINESS.installs.asOf})`],
  ['Solar pump / tubewell installations', `${BUSINESS.installs.solarPumps} (as of ${BUSINESS.installs.asOf})`],
  ['Google rating', `${BUSINESS.google.rating.toFixed(1)} from ${BUSINESS.google.reviewCount} reviews`],
  ['Area served', `${BUSINESS.serviceArea.join(', ')} and the rest of Punjab`],
  ['GST', BUSINESS.registrations.gst],
  ['Udyam (MSME) registration', BUSINESS.registrations.msme],
];
---

<BaseLayout
  title="About RSK Solar Energy, UTL Solar Distributor in Mohali"
  description={`RSK Solar Energy: UTL Solar distributor and rooftop solar installer in Phase 8B, Mohali, since ${BUSINESS.foundedYear}. Homes, businesses and housing societies across Punjab.`}
  crumbs={[{ name: 'About', path: '/about/' }]}
>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]} />
    <h1 class="t-h1 mt-6 max-w-4xl">RSK Solar Energy, Phase 8B Mohali</h1>
    <p class="t-lead measure mt-5">
      A {BUSINESS.brand} distributor and rooftop solar installer, founded in {BUSINESS.foundedYear}. We supply UTL products across Punjab, and design and install on-grid, hybrid and off-grid systems for homes, businesses and housing societies.
    </p>
    <figure class="mt-10">
      <Image src={officePhoto} alt="RSK Solar Energy office at E-203, Phase 8B Industrial Area, Mohali, with the UTL Solar distributor sign" widths={[640, 1024, 1600, 2000]} sizes="(min-width: 80rem) 76rem, 100vw" loading="eager" fetchpriority="high" class="h-auto w-full border border-rule" />
      <figcaption class="t-small mt-2 text-slate">E-203, Phase 8B Industrial Area, Sector 74, Mohali, opposite Nexa Tower.</figcaption>
    </figure>
  </header>

  <section class="wrap grid-12 pb-16" aria-labelledby="facts-h">
    <div class="lg:col-span-7">
      <h2 id="facts-h" class="sr-only">RSK Solar Energy in figures</h2>
      <table class="spec-table">
        <tbody>
          {
            facts.map(([k, v]) => (
              <tr>
                <th scope="row" class="text-slate">
                  {k}
                </th>
                <td class="text-right font-medium">{v}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-4"><a href={BUSINESS.google.mapsUrl} class="btn-tertiary" rel="noopener" target="_blank">Find us on Google Maps</a></p>
    </div>
    <aside class="lg:col-span-4 lg:col-start-9">
      <CtaBlock />
    </aside>
  </section>

  <section class="sec-tight bg-white" aria-labelledby="place-h">
    <div class="wrap">
      <h2 id="place-h" class="t-h2">Our office and warehouse</h2>
      <p class="measure mt-3 text-slate">E-203, Phase 8B, Mohali: the office, and the store rooms where UTL stock waits for dispatch and installation. You are welcome to visit during opening hours.</p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <figure>
          <Image src={meetingCabin} alt="Meeting cabin at the RSK Solar Energy office in Phase 8B, Mohali" widths={[400, 800, 1200]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 50vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">The meeting cabin, where we go through sizing, quotes and paperwork.</figcaption>
        </figure>
        <figure>
          <Image src={teamAtWork} alt="RSK Solar Energy office team working at their desks in Mohali" widths={[400, 800, 1200]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 50vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">Our office team at E-203.</figcaption>
        </figure>
        <figure>
          <Image src={panelsAndBatteries} alt="Solar panels, UTL lithium batteries and solar PCUs in the RSK Solar Energy store room" widths={[400, 800, 1200]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 50vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">Panels, lithium and tubular batteries, and PCUs in the store room.</figcaption>
        </figure>
        <figure>
          <Image src={pcusAndInverters} alt="Boxed UTL Gamma+ and Heliac solar PCUs and Taqnia inverters in stock at RSK Solar Energy" widths={[400, 800, 1200]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 50vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">UTL Gamma+ and Heliac solar PCUs and Taqnia inverters.</figcaption>
        </figure>
        <figure>
          <Image src={panelStack} alt="A stack of solar panels leaning against the wall in the RSK Solar Energy store room" widths={[400, 800, 1200]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 50vw, 100vw" class="aspect-[4/3] w-full border border-rule object-cover" />
          <figcaption class="t-small mt-2 text-slate">Solar panels in the store room.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="on-ink sec-open bg-ink text-white" aria-labelledby="how-h">
    <div class="wrap grid-12">
      <h2 id="how-h" class="t-h2 lg:col-span-4">How we work</h2>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        <li>
          <h3 class="t-h3">We tell you when solar won’t pay for itself.</h3>
          <p class="mt-2 text-rule">
            A home using {F.free} units a month or less already pays nothing in Punjab. We say so, even though it costs us the sale.
          </p>
        </li>
        <li>
          <h3 class="t-h3">We size to your bill.</h3>
          <p class="mt-2 text-rule">
            Under Punjab's free-units rule, the right system is often the smallest one that brings your net units under {F.free}. Going bigger adds cost without adding savings.
          </p>
        </li>
        <li>
          <h3 class="t-h3">We show the numbers and the assumptions.</h3>
          <p class="mt-2 text-rule">
            Our <a href="/solar-calculator/" class="underline">calculator</a> uses the current PSPCL tariff and states every assumption it makes. You see the full result without giving a phone number.
          </p>
        </li>
        <li>
          <h3 class="t-h3">We are upfront about the subsidy.</h3>
          <p class="mt-2 text-rule">You pay the full cost first; the PM Surya Ghar subsidy reaches your bank {F.days} days after inspection, and we tell you that before you commit.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="what-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="what-h" class="t-h2">What we do</h2>
        <SolarPumpArt class="mt-8 max-w-sm" />
      </div>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        <li><a href="/products/" class="font-semibold underline">Supply UTL Solar products</a><span class="mt-1 block text-slate">Panels, inverters and PCUs, batteries, charge controllers and complete kits.</span></li>
        <li><a href="/solar-calculator/" class="font-semibold underline">Rooftop systems for homes</a><span class="mt-1 block text-slate">On-grid systems with the PM Surya Ghar subsidy, and hybrid systems for backup.</span></li>
        <li><a href="/commercial-solar-punjab/" class="font-semibold underline">Commercial and industrial systems</a><span class="mt-1 block text-slate">Shops, offices, clinics, schools and factories.</span></li>
        <li><a href="/housing-society-solar/" class="font-semibold underline">Housing societies and RWAs</a><span class="mt-1 block text-slate">Common facilities, with ₹18,000 per kW subsidy.</span></li>
        <li><a href="/off-grid-solar-systems/" class="font-semibold underline">Off-grid systems</a><span class="mt-1 block text-slate">Farmhouses and sites without reliable supply.</span></li>
        <li><a href="/solar-pumps/" class="font-semibold underline">Solar water pumps</a><span class="mt-1 block text-slate">Tubewells and irrigation for farmers, 100+ installed.</span></li>
        <li><a href="/solar-dealership-punjab/" class="font-semibold underline">Dealer supply (B2B)</a><span class="mt-1 block text-slate">Wholesale UTL products for electricians, installers and shops across Punjab.</span></li>
      </ul>
    </div>
  </section>
</BaseLayout>
