---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BUSINESS } from '../config/business';
import { CITIES, cityPath } from '../data/locations';

const path = '/solar-company-punjab/';
const direct = CITIES.filter((c) => c.tier === 'direct');
const partner = CITIES.filter((c) => c.tier === 'partner');
const districts = [...new Set(partner.map((c) => c.district))]
  .sort((a, b) => a.localeCompare(b))
  .map((d) => ({ district: d, cities: partner.filter((c) => c.district === d).sort((a, b) => a.name.localeCompare(b.name)) }));
const title = 'Rooftop Solar Across Punjab: Cities We Serve';
const description = `Rooftop solar in ${CITIES.length} locations across every district of Punjab: our own team in Tricity, Kurali, Morinda and Ropar, and UTL dealers elsewhere.`;
---

<BaseLayout title={title} description={description} crumbs={[{ name: 'Locations', path }]}>
  <header class="wrap pt-8 pb-10 lg:pt-12">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Locations', path }]} />
    <h1 class="t-h1 mt-6">Solar across Punjab</h1>
    <p class="t-lead measure mt-5">
      RSK Solar Energy installs directly in Mohali, the Tricity, and around Kurali, Morinda and Ropar. Elsewhere in Punjab we reach you through our UTL Solar dealer network. See <a href="/solar-dealership-punjab/" class="underline">become a dealer</a> if that's you.
    </p>
  </header>

  <section class="sec-tight bg-white" aria-labelledby="direct-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="direct-h" class="t-h2">Where we install directly</h2>
        <p class="mt-3 text-slate">Worked from our office at {BUSINESS.address.street}, {BUSINESS.address.locality}.</p>
      </div>
      <ul class="ruled lg:col-span-7 lg:col-start-6">
        {direct.map((c) => (
          <li>
            <a href={cityPath(c.slug)} class="grid grid-cols-[1fr_auto] gap-x-6 no-underline">
              <span class="t-h3 block underline decoration-rule">{c.name}</span>
              <span class="t-value text-slate self-center">{c.district}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="partner-h">
    <div class="wrap grid-12">
      <div class="lg:col-span-4">
        <h2 id="partner-h" class="t-h2">Where our dealer network reaches</h2>
        <p class="mt-3 text-slate">Sized and quoted from Mohali; installation arranged locally through a dealer or partner.</p>
      </div>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        {districts.map((g) => (
          <div>
            <h3 class="t-small font-semibold text-slate">{g.district}</h3>
            <ul class="mt-2">
              {g.cities.map((c) => (
                <li class="py-1">
                  <a href={cityPath(c.slug)} class="underline">
                    Solar in {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
