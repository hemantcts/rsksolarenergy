---
/** Hindi and Punjabi pages: /hi/, /hi/<slug>/, /pa/, /pa/<slug>/. Content in src/content/translations/. */
import { getCollection, render } from 'astro:content';
import TranslatedLayout from '../../layouts/TranslatedLayout.astro';
import { article, faqPage } from '../../lib/seo';
import { translationPath } from '../../i18n/ui';

export async function getStaticPaths() {
  const pages = await getCollection('translations');
  return pages.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    const slug = rest.join('/');
    return { params: { lang, slug: slug === '' || slug === 'index' ? undefined : slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = translationPath(entry.id);
const isHome = path === `/${d.lang}/`;
const schema = [
  ...(isHome ? [] : [article({ title: d.h1, description: d.description, path, published: d.updated, updated: d.updated })]),
  ...(d.faq.length ? [faqPage(d.faq)] : []),
];
---

<TranslatedLayout
  lang={d.lang}
  title={d.title}
  description={d.description}
  h1={d.h1}
  lead={d.lead}
  crumbs={isHome ? [] : [{ name: d.crumb, path }]}
  schema={schema}
  faq={d.faq}
  related={d.related}
  cta={d.cta}
  updated={d.updated}
>
  <Content />
</TranslatedLayout>
